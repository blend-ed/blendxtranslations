msgid "National ID / Iqama"
msgstr "နိုင်ငံသား ID / Iqama"

msgid "10 digits, starting with 1, 2, or 4"
msgstr "ဂဏန်း ၁၀ လုံး၊ 1၊ 2 သို့မဟုတ် 4 ဖြင့် စတင်ရမည်"

msgid "National ID / Iqama must be 10 digits and start with 1, 2, or 4."
msgstr ""
"နိုင်ငံသား ID / Iqama သည် ဂဏန်း ၁၀ လုံးဖြစ်ပြီး 1၊ 2 သို့မဟုတ် 4 ဖြင့် "
"စတင်ရမည်။"

msgid "National ID / Iqama can't be changed after registration."
msgstr "မှတ်ပုံတင်ပြီးနောက် နိုင်ငံသား ID / Iqama ကို ပြောင်းလဲ၍မရပါ။"
