msgid "National ID / Iqama"
msgstr "Национальный ID / Икама"

msgid "10 digits, starting with 1, 2, or 4"
msgstr "10 цифр, начиная с 1, 2 или 4"

msgid "National ID / Iqama must be 10 digits and start with 1, 2, or 4."
msgstr ""
"Национальный ID / Икама должен состоять из 10 цифр и начинаться с 1, 2 или "
"4."

msgid "National ID / Iqama can't be changed after registration."
msgstr "Национальный ID / Икаму нельзя изменить после регистрации."
