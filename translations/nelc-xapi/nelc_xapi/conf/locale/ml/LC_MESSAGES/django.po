msgid "National ID / Iqama"
msgstr "ദേശീയ ID / ഇഖാമ"

msgid "10 digits, starting with 1, 2, or 4"
msgstr "1, 2, അല്ലെങ്കിൽ 4-ൽ ആരംഭിക്കുന്ന 10 അക്കങ്ങൾ"

msgid "National ID / Iqama must be 10 digits and start with 1, 2, or 4."
msgstr ""
"ദേശീയ ID / ഇഖാമ 10 അക്കങ്ങളുള്ളതും 1, 2, അല്ലെങ്കിൽ 4-ൽ "
"ആരംഭിക്കുന്നതുമായിരിക്കണം."

msgid "National ID / Iqama can't be changed after registration."
msgstr "രജിസ്ട്രേഷന് ശേഷം ദേശീയ ID / ഇഖാമ മാറ്റാനാവില്ല."
