msgid "National ID / Iqama"
msgstr "رقم الهوية الوطنية / الإقامة"

msgid "10 digits, starting with 1, 2, or 4"
msgstr "10 أرقام، تبدأ بـ 1 أو 2 أو 4"

msgid "National ID / Iqama must be 10 digits and start with 1, 2, or 4."
msgstr ""
"يجب أن يتكوّن رقم الهوية الوطنية / الإقامة من 10 أرقام وأن يبدأ بـ 1 أو 2 أو"
" 4."

msgid "National ID / Iqama can't be changed after registration."
msgstr "لا يمكن تغيير رقم الهوية الوطنية / الإقامة بعد التسجيل."
