msgid "National ID / Iqama"
msgstr "Documento d'identità nazionale / Iqama"

msgid "10 digits, starting with 1, 2, or 4"
msgstr "10 cifre, che iniziano con 1, 2 o 4"

msgid "National ID / Iqama must be 10 digits and start with 1, 2, or 4."
msgstr ""
"Il documento d'identità nazionale / Iqama deve avere 10 cifre e iniziare con"
" 1, 2 o 4."

msgid "National ID / Iqama can't be changed after registration."
msgstr ""
"Il documento d'identità nazionale / Iqama non può essere modificato dopo la "
"registrazione."
