msgid "National ID / Iqama"
msgstr "Personalausweisnummer / Iqama"

msgid "10 digits, starting with 1, 2, or 4"
msgstr "10 Ziffern, beginnend mit 1, 2 oder 4"

msgid "National ID / Iqama must be 10 digits and start with 1, 2, or 4."
msgstr ""
"Personalausweisnummer / Iqama muss aus 10 Ziffern bestehen und mit 1, 2 oder"
" 4 beginnen."

msgid "National ID / Iqama can't be changed after registration."
msgstr ""
"Personalausweisnummer / Iqama kann nach der Registrierung nicht mehr "
"geändert werden."
