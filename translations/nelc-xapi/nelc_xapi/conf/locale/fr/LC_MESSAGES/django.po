msgid "National ID / Iqama"
msgstr "Carte d'identité nationale / Iqama"

msgid "10 digits, starting with 1, 2, or 4"
msgstr "10 chiffres, commençant par 1, 2 ou 4"

msgid "National ID / Iqama must be 10 digits and start with 1, 2, or 4."
msgstr ""
"La carte d'identité nationale / Iqama doit comporter 10 chiffres et "
"commencer par 1, 2 ou 4."

msgid "National ID / Iqama can't be changed after registration."
msgstr ""
"La carte d'identité nationale / Iqama ne peut pas être modifiée après "
"l'inscription."
