msgid "National ID / Iqama"
msgstr "राष्ट्रीय ID / इक़ामा"

msgid "10 digits, starting with 1, 2, or 4"
msgstr "10 अंक, 1, 2 या 4 से शुरू होने वाले"

msgid "National ID / Iqama must be 10 digits and start with 1, 2, or 4."
msgstr ""
"राष्ट्रीय ID / इक़ामा 10 अंकों का होना चाहिए और 1, 2 या 4 से शुरू होना "
"चाहिए।"

msgid "National ID / Iqama can't be changed after registration."
msgstr "पंजीकरण के बाद राष्ट्रीय ID / इक़ामा बदला नहीं जा सकता।"
