msgstr "При удалении сеанса чата произошла ошибка."

msgid "AI features have been disabled for your organisation."
msgstr "Функции AI отключены для вашей организации."

msgid "Context ID is required"
msgstr "Требуется Context ID"

msgid "User cannot access course outside their organization: {org_name}"
msgstr ""
"Пользователь не может получить доступ к курсу вне своей организации: "
"{org_name}"

