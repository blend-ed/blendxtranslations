msgstr "Échec de la création de l'atome de connaissance : {error}"

msgid "Please provide a valid message."
msgstr "Veuillez saisir un message valide."

msgid "Please provide a message."
msgstr "Veuillez saisir un message."

msgid ""
"I apologize, but I encountered an error processing your request. Please try "
"again."
msgstr ""
"Je suis désolé, une erreur s'est produite lors du traitement de votre "
"demande. Veuillez réessayer."

msgid ""
"I apologize, but I encountered an error processing your request. Please try "
"again later."
msgstr ""
"Je suis désolé, une erreur s'est produite lors du traitement de votre "
"demande. Veuillez réessayer plus tard."

