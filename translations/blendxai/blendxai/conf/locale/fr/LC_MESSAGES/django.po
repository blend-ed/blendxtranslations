"Impossible de trouver la première unité du cours. Assurez-vous que le cours "
"comporte au moins une section, une sous-section et une unité."

msgid "Failed to create component block"
msgstr "Échec de la création du bloc de composant"

msgid "Successfully created {component_type} component \"{component_name}\""
msgstr "Composant {component_type} « {component_name} » créé avec succès"

