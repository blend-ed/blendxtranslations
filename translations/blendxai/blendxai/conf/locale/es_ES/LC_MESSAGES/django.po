msgstr "Cada elemento de content_tagged debe tener un content_id"

msgid "Each item in content_tagged must have taxonomy_suggestions"
msgstr "Cada elemento de content_tagged debe tener taxonomy_suggestions"

msgid "No available taxonomies found for organization"
msgstr "No se han encontrado taxonomías disponibles para la organización"

msgid "Failed to get taxonomies: {error}"
msgstr "No se han podido obtener las taxonomías: {error}"

