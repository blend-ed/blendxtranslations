msgid "The AI produced invalid problem content: {error}"
msgstr "AI അസാധുവായ പ്രോബ്ലം ഉള്ളടക്കം സൃഷ്ടിച്ചു: {error}"

msgid "Failed to generate component: {error}"
msgstr "ഘടകം സൃഷ്ടിക്കാനായില്ല: {error}"

msgid "Failed to generate image: {error}"
msgstr "ചിത്രം സൃഷ്ടിക്കാനായില്ല: {error}"

msgid "The AI could not generate an image. Try rephrasing your description."
msgstr ""
"AI-ക്ക് ചിത്രം സൃഷ്ടിക്കാനായില്ല. നിങ്ങളുടെ വിവരണം മറ്റൊരു രീതിയിൽ എഴുതി "
"നോക്കുക."

msgid "Invalid parent_locator."
msgstr "അസാധുവായ parent_locator."

msgid "You do not have permission to edit this course."
msgstr "ഈ കോഴ്സ് എഡിറ്റ് ചെയ്യാൻ നിങ്ങൾക്ക് അനുമതിയില്ല."

msgid "AI usage has been disabled for your account."
msgstr "നിങ്ങളുടെ അക്കൗണ്ടിന് AI ഉപയോഗം പ്രവർത്തനരഹിതമാക്കി."

msgid ""
"Writing this component needs library.edit and library.publish on your "
"organisation, besides course.edit on the course."
msgstr ""
"ഈ ഘടകം എഴുതാൻ, കോഴ്സിലെ course.edit-ന് പുറമേ നിങ്ങളുടെ സ്ഥാപനത്തിൽ "
"library.edit, library.publish എന്നിവയും ആവശ്യമാണ്."

