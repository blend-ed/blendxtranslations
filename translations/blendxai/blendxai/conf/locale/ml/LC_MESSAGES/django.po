msgid "Organization not found."
msgstr "സ്ഥാപനം കണ്ടെത്തിയില്ല."

msgid "Failed to create a new chat session."
msgstr "പുതിയ ചാറ്റ് സെഷൻ സൃഷ്ടിക്കാനായില്ല."

msgid "Chat session not found."
msgstr "ചാറ്റ് സെഷൻ കണ്ടെത്തിയില്ല."

msgid ""
"An error occurred while processing your request. Please try again later."
msgstr ""
"നിങ്ങളുടെ അഭ്യർത്ഥന പ്രോസസ്സ് ചെയ്യുമ്പോൾ ഒരു പിശക് സംഭവിച്ചു. ദയവായി "
"പിന്നീട് വീണ്ടും ശ്രമിക്കുക."

msgid "An error occurred while creating the chat session."
msgstr "ചാറ്റ് സെഷൻ സൃഷ്ടിക്കുമ്പോൾ ഒരു പിശക് സംഭവിച്ചു."

msgid "Session not found."
msgstr "സെഷൻ കണ്ടെത്തിയില്ല."

msgid "sessionName is required."
msgstr "sessionName ആവശ്യമാണ്."

msgid "Failed to rename the chat session."
msgstr "ചാറ്റ് സെഷന്റെ പേര് മാറ്റാനായില്ല."

msgid "An error occurred while renaming the chat session."
msgstr "ചാറ്റ് സെഷന്റെ പേര് മാറ്റുമ്പോൾ ഒരു പിശക് സംഭവിച്ചു."

msgid "Failed to delete the chat session."
msgstr "ചാറ്റ് സെഷൻ ഇല്ലാതാക്കാനായില്ല."

msgid "An error occurred while deleting the chat session."
msgstr "ചാറ്റ് സെഷൻ ഇല്ലാതാക്കുമ്പോൾ ഒരു പിശക് സംഭവിച്ചു."

msgid "AI features have been disabled for your organisation."
msgstr "നിങ്ങളുടെ സ്ഥാപനത്തിന് AI ഫീച്ചറുകൾ പ്രവർത്തനരഹിതമാക്കി."

msgid "Context ID is required"
msgstr "Context ID ആവശ്യമാണ്"

msgid "User cannot access course outside their organization: {org_name}"
msgstr ""
"ഉപയോക്താവിന് അവരുടെ സ്ഥാപനത്തിന് പുറത്തുള്ള കോഴ്സ് ആക്സസ് ചെയ്യാനാവില്ല: "
"{org_name}"

msgid "Failed to auto-tag course: {error}"
msgstr "കോഴ്സ് ഓട്ടോ-ടാഗ് ചെയ്യാനായില്ല: {error}"

msgid "Task not found."
msgstr "ടാസ്ക് കണ്ടെത്തിയില്ല."

msgid "No content_tagged data provided"
msgstr "content_tagged ഡാറ്റ നൽകിയിട്ടില്ല"

msgid "Each item in content_tagged must have a content_id"
msgstr "content_tagged-ലെ ഓരോ ഇനത്തിനും ഒരു content_id ഉണ്ടായിരിക്കണം"

msgid "Each item in content_tagged must have taxonomy_suggestions"
msgstr "content_tagged-ലെ ഓരോ ഇനത്തിനും taxonomy_suggestions ഉണ്ടായിരിക്കണം"

msgid "No available taxonomies found for organization"
msgstr "സ്ഥാപനത്തിന് ലഭ്യമായ ടാക്സോണമികളൊന്നും കണ്ടെത്തിയില്ല"

msgid "Failed to get taxonomies: {error}"
msgstr "ടാക്സോണമികൾ ലഭ്യമാക്കാനായില്ല: {error}"

msgid "Failed to apply tags: {error}"
msgstr "ടാഗുകൾ പ്രയോഗിക്കാനായില്ല: {error}"

msgid "Failed to get course outline: {error}"
msgstr "കോഴ്സ് രൂപരേഖ ലഭ്യമാക്കാനായില്ല: {error}"

msgid "Failed to build course content list: {error}"
msgstr "കോഴ്സ് ഉള്ളടക്ക ലിസ്റ്റ് നിർമ്മിക്കാനായില്ല: {error}"

msgid "Failed to get course hierarchy: {error}"
msgstr "കോഴ്സ് ശ്രേണി ലഭ്യമാക്കാനായില്ല: {error}"

msgid "Failed to remove tags: {error}"
msgstr "ടാഗുകൾ നീക്കം ചെയ്യാനായില്ല: {error}"

msgid "Error occurred while initializing image LLM"
msgstr "ഇമേജ് LLM ആരംഭിക്കുമ്പോൾ പിശക് സംഭവിച്ചു"

msgid "Title and description are required"
msgstr "തലക്കെട്ടും വിവരണവും ആവശ്യമാണ്"

msgid "AI features are disabled for this user."
msgstr "ഈ ഉപയോക്താവിന് AI ഫീച്ചറുകൾ പ്രവർത്തനരഹിതമാണ്."

msgid "Error occurred while generating program image"
msgstr "പ്രോഗ്രാം ചിത്രം സൃഷ്ടിക്കുമ്പോൾ പിശക് സംഭവിച്ചു"

msgid ""
"AI for staff is turned off for your organisation. Please contact Blend-ed."
msgstr ""
"നിങ്ങളുടെ സ്ഥാപനത്തിനായി സ്റ്റാഫിനുള്ള AI ഓഫാണ്. ദയവായി Blend-ed-നെ "
"ബന്ധപ്പെടുക."
