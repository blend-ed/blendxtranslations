msgid "Display Name"
msgstr "表示名"

msgid "Display name for this module"
msgstr "このモジュールの表示名"

msgid "Path to the index page in scorm file"
msgstr "SCORMファイル内のインデックスページへのパス"

msgid "Weight"
msgstr "重み"

msgid "Weight/Maximum grade"
msgstr "重み/最高点"

msgid "Scored"
msgstr "採点対象"

msgid ""
"Select False if this component will not receive a numerical score from the "
"Scorm"
msgstr "このコンポーネントがSCORMから数値スコアを受け取らない場合は、Falseを選択してください"

msgid "Display width (px)"
msgstr "表示の幅(px)"

msgid "Width of iframe (default: 100%)"
msgstr "iframeの幅(既定: 100%)"

msgid "Display height (px)"
msgstr "表示の高さ(px)"

msgid "Height of iframe"
msgstr "iframeの高さ"

msgid "Launch in pop-up window"
msgstr "ポップアップウィンドウで起動"

msgid ""
"Launch in pop-up window instead of embedding the SCORM content in an iframe."
" Enable this for older packages that need to be run in separate window."
msgstr ""
"SCORMコンテンツをiframeに埋め込む代わりに、ポップアップウィンドウで起動します。別ウィンドウで実行する必要がある古いパッケージの場合に有効にしてください。"

msgid "Display navigation menu"
msgstr "ナビゲーションメニューを表示"

msgid ""
"Select True to display a navigation menu on the left side to display table "
"of contents"
msgstr "左側に目次を表示するナビゲーションメニューを表示するには、Trueを選択してください"

msgid "Show Fullscreen Button"
msgstr "全画面表示ボタンを表示"

msgid "Select True to show fullscreen button in the SCORM content"
msgstr "SCORMコンテンツに全画面表示ボタンを表示するには、Trueを選択してください"

msgid "Display width of navigation menu(px)"
msgstr "ナビゲーションメニューの表示幅(px)"

msgid ""
"Width of navigation menu. This assumes that Navigation Menu is enabled. "
"(default: 30%)"
msgstr "ナビゲーションメニューの幅。ナビゲーションメニューが有効であることが前提です。(既定: 30%)"

msgid "points"
msgstr "ポイント"

msgid "Fullscreen"
msgstr "全画面表示"

msgid "Exit fullscreen"
msgstr "全画面表示を終了"

msgid "Launch unit in new window"
msgstr "単元を新しいウィンドウで起動"

msgid "View SCORM reports"
msgstr "SCORMレポートを表示"

msgid "Upload .zip package"
msgstr ".zipパッケージをアップロード"

msgid "Currently:"
msgstr "現在:"

msgid "True"
msgstr "True"

msgid "False"
msgstr "False"

msgid "Save"
msgstr "保存"

msgid "Cancel"
msgstr "キャンセル"
