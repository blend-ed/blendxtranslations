msgid "Display Name"
msgstr "Отображаемое название"

msgid "Display name for this module"
msgstr "Отображаемое название этого модуля"

msgid "Path to the index page in scorm file"
msgstr "Путь к начальной странице в файле SCORM"

msgid "Weight"
msgstr "Вес"

msgid "Weight/Maximum grade"
msgstr "Вес/максимальная оценка"

msgid "Scored"
msgstr "Оценивается"

msgid ""
"Select False if this component will not receive a numerical score from the "
"Scorm"
msgstr ""
"Выберите False, если этот компонент не будет получать числовой балл от SCORM"

msgid "Display width (px)"
msgstr "Ширина отображения (px)"

msgid "Width of iframe (default: 100%)"
msgstr "Ширина iframe (по умолчанию: 100%)"

msgid "Display height (px)"
msgstr "Высота отображения (px)"

msgid "Height of iframe"
msgstr "Высота iframe"

msgid "Launch in pop-up window"
msgstr "Запускать во всплывающем окне"

msgid ""
"Launch in pop-up window instead of embedding the SCORM content in an iframe."
" Enable this for older packages that need to be run in separate window."
msgstr ""
"Запускать во всплывающем окне вместо встраивания контента SCORM в iframe. "
"Включите для старых пакетов, которые нужно запускать в отдельном окне."

msgid "Display navigation menu"
msgstr "Показывать меню навигации"

msgid ""
"Select True to display a navigation menu on the left side to display table "
"of contents"
msgstr "Выберите True, чтобы слева отображалось меню навигации с оглавлением"

msgid "Show Fullscreen Button"
msgstr "Показывать кнопку полноэкранного режима"

msgid "Select True to show fullscreen button in the SCORM content"
msgstr ""
"Выберите True, чтобы показывать кнопку полноэкранного режима в контенте "
"SCORM"

msgid "Display width of navigation menu(px)"
msgstr "Ширина меню навигации (px)"

msgid ""
"Width of navigation menu. This assumes that Navigation Menu is enabled. "
"(default: 30%)"
msgstr ""
"Ширина меню навигации. Предполагается, что меню навигации включено. (по "
"умолчанию: 30%)"

msgid "points"
msgstr "баллы"

msgid "Fullscreen"
msgstr "Полноэкранный режим"

msgid "Exit fullscreen"
msgstr "Выйти из полноэкранного режима"

msgid "Launch unit in new window"
msgstr "Запускать блок в новом окне"

msgid "View SCORM reports"
msgstr "Смотреть отчёты SCORM"

msgid "Upload .zip package"
msgstr "Загрузить пакет .zip"

msgid "Currently:"
msgstr "Сейчас:"

msgid "True"
msgstr "Верно"

msgid "False"
msgstr "Неверно"

msgid "Save"
msgstr "Сохранить"

msgid "Cancel"
msgstr "Отмена"
