msgid "Display Name"
msgstr "Nombre visible"

msgid "Display name for this module"
msgstr "Nombre visible de este módulo"

msgid "Path to the index page in scorm file"
msgstr "Ruta a la página de índice en el archivo SCORM"

msgid "Weight"
msgstr "Peso"

msgid "Weight/Maximum grade"
msgstr "Peso/nota máxima"

msgid "Scored"
msgstr "Puntuado"

msgid ""
"Select False if this component will not receive a numerical score from the "
"Scorm"
msgstr ""
"Seleccione Falso si este componente no va a recibir una puntuación numérica "
"del SCORM"

msgid "Display width (px)"
msgstr "Anchura de visualización (px)"

msgid "Width of iframe (default: 100%)"
msgstr "Anchura del iframe (predeterminada: 100 %)"

msgid "Display height (px)"
msgstr "Altura de visualización (px)"

msgid "Height of iframe"
msgstr "Altura del iframe"

msgid "Launch in pop-up window"
msgstr "Abrir en una ventana emergente"

msgid ""
"Launch in pop-up window instead of embedding the SCORM content in an iframe."
" Enable this for older packages that need to be run in separate window."
msgstr ""
"Abrir en una ventana emergente en lugar de insertar el contenido SCORM en un"
" iframe. Actívelo para paquetes antiguos que deban ejecutarse en una ventana"
" aparte."

msgid "Display navigation menu"
msgstr "Mostrar menú de navegación"

msgid ""
"Select True to display a navigation menu on the left side to display table "
"of contents"
msgstr ""
"Seleccione Verdadero para mostrar un menú de navegación a la izquierda con "
"el índice de contenidos"

msgid "Show Fullscreen Button"
msgstr "Mostrar botón de pantalla completa"

msgid "Select True to show fullscreen button in the SCORM content"
msgstr ""
"Seleccione Verdadero para mostrar el botón de pantalla completa en el "
"contenido SCORM"

msgid "Display width of navigation menu(px)"
msgstr "Anchura de visualización del menú de navegación (px)"

msgid ""
"Width of navigation menu. This assumes that Navigation Menu is enabled. "
"(default: 30%)"
msgstr ""
"Anchura del menú de navegación. Se supone que el menú de navegación está "
"activado. (predeterminada: 30 %)"

msgid "points"
msgstr "puntos"

msgid "Fullscreen"
msgstr "Pantalla completa"

msgid "Exit fullscreen"
msgstr "Salir de pantalla completa"

msgid "Launch unit in new window"
msgstr "Abrir la unidad en una ventana nueva"

msgid "View SCORM reports"
msgstr "Ver informes SCORM"

msgid "Upload .zip package"
msgstr "Subir paquete .zip"

msgid "Currently:"
msgstr "Actualmente:"

msgid "True"
msgstr "Verdadero"

msgid "False"
msgstr "Falso"

msgid "Save"
msgstr "Guardar"

msgid "Cancel"
msgstr "Cancelar"
