msgid "Display Name"
msgstr "Nome visualizzato"

msgid "Display name for this module"
msgstr "Nome visualizzato per questo modulo"

msgid "Path to the index page in scorm file"
msgstr "Percorso della pagina index nel file SCORM"

msgid "Weight"
msgstr "Peso"

msgid "Weight/Maximum grade"
msgstr "Peso/Voto massimo"

msgid "Scored"
msgstr "Con punteggio"

msgid ""
"Select False if this component will not receive a numerical score from the "
"Scorm"
msgstr ""
"Seleziona Falso se questo componente non riceverà un punteggio numerico "
"dallo SCORM"

msgid "Display width (px)"
msgstr "Larghezza di visualizzazione (px)"

msgid "Width of iframe (default: 100%)"
msgstr "Larghezza dell'iframe (predefinita: 100%)"

msgid "Display height (px)"
msgstr "Altezza di visualizzazione (px)"

msgid "Height of iframe"
msgstr "Altezza dell'iframe"

msgid "Launch in pop-up window"
msgstr "Avvia in una finestra pop-up"

msgid ""
"Launch in pop-up window instead of embedding the SCORM content in an iframe."
" Enable this for older packages that need to be run in separate window."
msgstr ""
"Avvia in una finestra pop-up invece di incorporare il contenuto SCORM in un "
"iframe. Attivalo per i pacchetti meno recenti che devono essere eseguiti in "
"una finestra separata."

msgid "Display navigation menu"
msgstr "Mostra il menu di navigazione"

msgid ""
"Select True to display a navigation menu on the left side to display table "
"of contents"
msgstr ""
"Seleziona Vero per mostrare a sinistra un menu di navigazione con l'indice "
"dei contenuti"

msgid "Show Fullscreen Button"
msgstr "Mostra il pulsante schermo intero"

msgid "Select True to show fullscreen button in the SCORM content"
msgstr ""
"Seleziona Vero per mostrare il pulsante schermo intero nel contenuto SCORM"

msgid "Display width of navigation menu(px)"
msgstr "Larghezza di visualizzazione del menu di navigazione (px)"

msgid ""
"Width of navigation menu. This assumes that Navigation Menu is enabled. "
"(default: 30%)"
msgstr ""
"Larghezza del menu di navigazione. Presuppone che il menu di navigazione sia"
" attivato. (predefinita: 30%)"

msgid "points"
msgstr "punti"

msgid "Fullscreen"
msgstr "Schermo intero"

msgid "Exit fullscreen"
msgstr "Esci da schermo intero"

msgid "Launch unit in new window"
msgstr "Avvia l'unità in una nuova finestra"

msgid "View SCORM reports"
msgstr "Vedi i report SCORM"

msgid "Upload .zip package"
msgstr "Carica il pacchetto .zip"

msgid "Currently:"
msgstr "Attuale:"

msgid "True"
msgstr "Vero"

msgid "False"
msgstr "Falso"

msgid "Save"
msgstr "Salva"

msgid "Cancel"
msgstr "Annulla"
