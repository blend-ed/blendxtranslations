msgid "Only the dates offered to the learner's Batch"
msgstr "仅限向学员所在班期开放的日期"

msgid "Any open date inside the learner's access window"
msgstr "学员访问期内的任意开放日期"

msgid "This Session unlocks after an earlier step."
msgstr "完成前面的步骤后才会解锁该课堂。"

msgid "Choose a date to book your place."
msgstr "选择日期以预约您的名额。"

msgid "Your organisation will book your Session."
msgstr "您的组织将为您预约课堂。"

msgid "Your date will be scheduled for you. You'll be booked automatically."
msgstr "系统会为你安排日期，并自动为你预约。"

msgid "You're booked."
msgstr "您已预约成功。"

msgid ""
"You're on the waitlist. You'll be booked automatically if a place frees up."
msgstr "您已在候补名单中。如有名额空出，系统将自动为您预约。"

msgid "You attended this Session."
msgstr "您已参加此课堂。"

msgid "You missed this Session."
msgstr "您错过了此课堂。"

msgid "You don't have access to this Session."
msgstr "您无权访问此课堂。"

msgid "Online"
msgstr "线上"

msgid "In person"
msgstr "线下"

msgid "Hybrid"
msgstr "混合"

msgid "Waitlisted"
msgstr "候补中"

msgid "Attended"
msgstr "已出勤"

msgid "Missed"
msgstr "缺席"

msgid "Part {part}"
msgstr "第 {part} 部分"

msgid "Waitlisted, number {position}"
msgstr "候补中，第 {position} 位"

msgid "Join now"
msgstr "立即加入"

msgid "Choose a date"
msgstr "选择日期"

msgid "Change or cancel"
msgstr "更改或取消"

msgid "Session details"
msgstr "课堂详情"

msgid "Add to calendar"
msgstr "添加到日历"

msgid "You can join from 15 minutes before the start."
msgstr "你可以在开始前 15 分钟加入。"

msgid "Your trainer set this date for your batch. Contact them to change it."
msgstr "讲师为你的班期设定了此日期。如需更改，请联系讲师。"

msgid "Times are in UTC. Set your time zone in your account settings."
msgstr "时间为 UTC。请在账户设置中设置你的时区。"

msgid "Display name"
msgstr "显示名称"

msgid "Live Session"
msgstr "实时课堂"

msgid "Session"
msgstr "课堂"

msgid "The stand-alone Session this unit links to."
msgstr "此单元关联的独立课堂。"

msgid "Required"
msgstr "必填"

msgid ""
"Learners must complete the Session to complete this part of the Course."
msgstr "学员必须完成该课堂，才能完成课程的这一部分。"

msgid "Which dates learners may book"
msgstr "学员可预约哪些日期"

msgid "Booking opens here when it's available."
msgstr "预约开放后将在此处显示。"

msgid "You're number {position} on the waitlist."
msgstr "你在候补名单中排第 {position} 位。"

msgid "No dates scheduled yet."
msgstr "尚未安排日期。"

msgid "Optional"
msgstr "可选"

msgid "Choose a Session."
msgstr "选择一个课堂。"

msgid "The Session no longer exists or can't be linked here."
msgstr "该课堂已不存在或无法在此处关联。"

msgid "The Session isn't published, so the link won't sync at publish."
msgstr "该课堂尚未发布，因此发布时链接不会同步。"

msgid "Choose which dates learners may book."
msgstr "选择学员可以预约的日期。"

msgid "Ready: the link syncs when the Course is published."
msgstr "已就绪：课程发布后链接会同步。"

msgid "(no Session selected)"
msgstr "（未选择课堂）"

msgid "Yes"
msgstr "是"

msgid "No"
msgstr "否"

msgid "Only course staff can change this block."
msgstr "只有课程职员可以更改此块。"

msgid "The form wasn't sent correctly."
msgstr "表单未正确发送。"

msgid "Choose a Session from the list."
msgstr "从列表中选择一个课堂。"

msgid "That Session can't be linked here."
msgstr "该课堂无法在此处关联。"

msgid "Required is yes or no."
msgstr "“必填”应为“是”或“否”。"

msgid "Kind"
msgstr "种类"

msgid "Upcoming dates"
msgstr "即将到来的日期"

msgid "Dates learners may book"
msgstr "学员可预约的日期"

msgid "Limit to modes"
msgstr "限定学习模式"

msgid "Use \"Restrict access\" on this component."
msgstr "请在此组件上使用“限制访问”。"

msgid "This Session isn't available yet."
msgstr "该课堂暂不可用。"

msgid "Choose a Session"
msgstr "选择课堂"

msgid "Required to complete this part of the Course"
msgstr "完成课程的这一部分所必需"

msgid ""
"To limit it to some learning modes, use \"Restrict access\" on the "
"component."
msgstr "如需将其限定于部分学习模式，请在组件上使用“限制访问”。"

msgid "Save"
msgstr "保存"

msgid "Cancel"
msgstr "取消"
