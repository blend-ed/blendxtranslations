msgstr "Срок выбора"

msgid "Choose people link"
msgstr "Ссылка «Выбрать людей»"

msgid "Hi {{ full_name }},"
msgstr "Здравствуйте, {{ full_name }}!"

#. Translators: %(course)s is the course's name in bold.
msgid ""
"You have a place in %(course)s at {{ org_name }}. Open it any time from My "
"learning."
msgstr ""
"У вас есть место на %(course)s в {{ org_name }}. Откройте его в любое время "
"в разделе «Моё обучение»."

msgid "You got this email because you were enrolled in {{ course_name }}."
msgstr "Вы получили это письмо, потому что вас записали на {{ course_name }}."

msgid "Your enrollment in {{ course_name }} changed"
msgstr "Ваша запись на {{ course_name }} изменилась"

#. Translators: %(course)s is the course's name in bold.
msgid ""
"Your access to %(course)s at {{ org_name }} changed. Open the course to see "
"what's new; you carry on from where you left off."
msgstr ""
"Ваш доступ к %(course)s в {{ org_name }} изменился. Откройте курс, чтобы "
"узнать, что нового; вы продолжите с того места, где остановились."

msgid ""
"You got this email because your enrollment in {{ course_name }} changed."
msgstr ""
"Вы получили это письмо, потому что ваша запись на {{ course_name }} "
"изменилась."

