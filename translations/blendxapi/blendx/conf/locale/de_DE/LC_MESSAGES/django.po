msgstr "Ihnen wurde das Ticket {title} zugewiesen."

#. Translators: {name} is who commented, {title} the ticket's title and
#. {comment} their words.
msgid "{name} commented on your ticket {title}: {comment}"
msgstr "{name} hat Ihr Ticket {title} kommentiert: {comment}"

