msgid ""
"You invited %(email)s to learn with %(tenant)s on %(day)s, and they haven't "
"accepted yet. You can send the invitation again from People."
msgstr ""
"Sie haben %(email)s am %(day)s eingeladen, mit %(tenant)s zu lernen, und die"
" Einladung wurde noch nicht angenommen. Sie können die Einladung unter "
"„Personen“ erneut senden."

msgid "a course"
msgstr "ein Kurs"

#. Translators: %(seats)s is a number of seats ("3 seats"); %(where)s what
#. they are for.
msgid "%(seats)s in %(where)s not given out yet"
msgstr "%(seats)s in %(where)s noch nicht vergeben"

