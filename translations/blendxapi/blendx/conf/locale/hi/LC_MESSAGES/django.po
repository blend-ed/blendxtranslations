msgstr "%(learner)s ने %(title)s खरीदा और अभी शुरू कर सकते हैं।"

msgid "%(learner)s enrolled in %(title)s"
msgstr "%(learner)s ने %(title)s में नामांकन किया"

msgid "%(learner)s enrolled themselves in %(title)s."
msgstr "%(learner)s ने स्वयं %(title)s में नामांकन किया।"

msgid "your subscription"
msgstr "आपकी सदस्यता"

msgid ""
"We couldn't take your payment of %(amount)s for %(name)s. Update your "
"payment method by %(day)s to keep your access."
msgstr ""
"हम %(name)s के लिए आपका %(amount)s का भुगतान नहीं ले सके। अपनी पहुँच बनाए "
"रखने के लिए %(day)s तक अपना भुगतान का तरीका अपडेट करें।"

msgid ""
"We couldn't take your payment of %(amount)s for %(name)s. Update your "
"payment method to keep your access."
msgstr ""
"हम %(name)s के लिए आपका %(amount)s का भुगतान नहीं ले सके। अपनी पहुँच बनाए "
"रखने के लिए अपना भुगतान का तरीका अपडेट करें।"

msgid "Your %(name)s payment couldn't be processed"
msgstr "आपका %(name)s भुगतान संसाधित नहीं हो सका"

msgid "We couldn't process your subscription payment."
msgstr "हम आपकी सदस्यता का भुगतान संसाधित नहीं कर सके।"

#. Translators: shown after a time written in UTC because the person chose no
#. time zone; {url} is the link
