msgstr "Nome del piano / prodotto"

msgid "Failed amount"
msgstr "Importo non riuscito"

msgid "Update payment / re-subscribe URL"
msgstr "URL per aggiornare il pagamento / riabbonarsi"

msgid "Failure reason"
msgstr "Motivo dell'errore"

msgid "Course Enrollment — New User"
msgstr "Iscrizione al corso — Nuovo utente"

msgid ""
"Sent when an unregistered user is enrolled in a course and has to register "
"before they can open it."
msgstr ""
"Inviata quando un utente non registrato viene iscritto a un corso e deve "
"registrarsi prima di poterlo aprire."

msgid "You've been enrolled in {{ display_name }}"
msgstr "Sei stato iscritto a {{ display_name }}"

msgid "Course/org name"
msgstr "Nome del corso/dell'organizzazione"

msgid "Custom Broadcast"
msgstr "Comunicazione personalizzata"

msgid ""
"The ad-hoc announcement staff compose and send from the notifications page."
msgstr ""
"L'annuncio occasionale che il personale redige e invia dalla pagina delle "
"notifiche."

msgid "{{ title }}"
msgstr "{{ title }}"

msgid "Open"
msgstr "Apri"

msgid "Notification title"
msgstr "Titolo della notifica"

msgid "Notification body"
msgstr "Corpo della notifica"

msgid "Sent by"
msgstr "Inviato da"

msgid "Deep-link target"
msgstr "Destinazione del deep link"

msgid "Deep-link button label"
msgstr "Etichetta del pulsante deep link"

