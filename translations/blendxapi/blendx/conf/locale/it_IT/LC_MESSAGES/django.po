"Sent when a recurring subscription payment fails permanently and access "
"ends."
msgstr ""
"Inviata quando un pagamento ricorrente dell'abbonamento non riesce "
"definitivamente e l'accesso termina."

msgid "Your {{ plan_name }} payment couldn't be processed"
msgstr "Non è stato possibile elaborare il pagamento di {{ plan_name }}"

msgid "Update payment method"
msgstr "Aggiorna il metodo di pagamento"

