msgstr ""
"Recibe este correo electrónico porque se le asignó un rol en {{ org_name }}."

#. Translators: %(workspace)s is the new organisation's name in bold.
msgid ""
"Thanks for signing up for the AI Course Creator free trial on {{ "
"platform_name }}. Your workspace, %(workspace)s, is set up and your account "
"is active. Sign in to start building courses with AI."
msgstr ""
"Gracias por registrarse en la prueba gratuita de AI Course Creator en {{ "
"platform_name }}. Su espacio de trabajo, %(workspace)s, está configurado y "
"su cuenta está activa. Inicie sesión para empezar a crear cursos con AI."

#. Translators: %(address)s is the organisation's reply-to email address, as a
#. link.
msgid "Questions? Write to %(address)s."
msgstr "¿Tiene preguntas? Escriba a %(address)s."

msgid ""
"You got this email because you signed up for a free trial with {{ "
"email_address }}."
msgstr ""
"Recibe este correo electrónico porque se registró en una prueba gratuita con"
" {{ email_address }}."

msgid ""
"The password for your {{ platform_name }} account ({{ email_address }}) was "
"changed on {{ changed_at }}."
msgstr ""
"La contraseña de su cuenta de {{ platform_name }} ({{ email_address }}) se "
"cambió el {{ changed_at }}."

#. Translators: %(not_you)s is "Wasn't you?" in bold; %(address)s is the
#. reply-to email address, as a link.
msgid ""
"%(not_you)s Reset your password now from the sign-in page and contact "
"%(address)s."
msgstr ""
"%(not_you)s Restablezca su contraseña ahora desde la página de inicio de "
"sesión y póngase en contacto con %(address)s."

msgid "Wasn't you?"
msgstr "¿No ha sido usted?"

msgid ""
"You got this email because the password of your account changed. It can't be"
" switched off."
msgstr ""
"Recibe este correo electrónico porque ha cambiado la contraseña de su "
"cuenta. No se puede desactivar."

msgid "{{ raised_by }} raised a ticket."
msgstr "{{ raised_by }} ha abierto un ticket."

msgid "Type"
msgstr "Tipo"

msgid ""
"You got this email because you get support ticket alerts at {{ org_name }}."
msgstr ""
"Recibe este correo electrónico porque recibe alertas de tickets de soporte "
"en {{ org_name }}."

msgid "Claim your place at {{ org_name }}"
msgstr "Solicite su plaza en {{ org_name }}"

msgid "Your place is waiting:"
msgstr "Su plaza le espera:"

#. Translators: %(address)s is the buyer's email address in bold.
msgid ""
"Sign in or create an account with %(address)s, then claim your place: it is "
"for this address."
msgstr ""
"Inicie sesión o cree una cuenta con %(address)s y, después, solicite su "
"plaza: es para esta dirección."

msgid ""
"This link works until {{ expires_on }}. If you didn't ask for this, ignore "
"this email."
msgstr ""
"Este enlace funciona hasta el {{ expires_on }}. Si no lo ha solicitado, "
"ignore este correo electrónico."

msgid ""
"You got this email because a place at {{ org_name }} was requested for {{ "
"email_address }}."
msgstr ""
"Recibe este correo electrónico porque se solicitó una plaza en {{ org_name "
"}} para {{ email_address }}."

msgid "Thanks for your purchase"
msgstr "Gracias por su compra"

msgid "Hi {{ first_name }},"
msgstr "Hola, {{ first_name }}:"

msgid ""
"Your payment to {{ org_name }} went through. Here is your receipt for order "
"{{ order_number }}, paid on {{ order_date }}."
msgstr ""
"Se ha procesado su pago a {{ org_name }}. Este es su recibo del pedido {{ "
"order_number }}, pagado el {{ order_date }}."

msgid "Paid by {{ payment_method }}. You can start learning now."
msgstr "Pagado con {{ payment_method }}. Ya puede empezar a aprender."

msgid ""
"You got this email because you bought {{ items }} on {{ platform_name }}."
msgstr ""
"Recibe este correo electrónico porque compró {{ items }} en {{ platform_name"
" }}."

#. Translators: {{ reason }} is the payment provider's sentence; %(amount)s is
#. the currency and amount in
#. bold; %(plan)s is the plan's name in bold.
msgid ""
"{{ reason }} We tried to take %(amount)s for %(plan)s and the payment didn't"
" go through, so your access has ended."
msgstr ""
"{{ reason }} Intentamos cobrar %(amount)s por %(plan)s y el pago no se pudo "
"realizar, por lo que su acceso ha terminado."

msgid "Update your payment method to subscribe again."
msgstr "Actualice su método de pago para volver a suscribirse."

msgid ""
"You got this email because you subscribe to {{ plan_name }} with {{ "
"email_address }}. It can't be switched off."
msgstr ""
"Recibe este correo electrónico porque está suscrito a {{ plan_name }} con {{"
" email_address }}. No se puede desactivar."

#. Translators: %(name)s is the course's name in bold.
msgid ""
"{{ org_name }} enrolled you in %(name)s on {{ platform_name }}. Complete "
"your registration to open it."
msgstr ""
"{{ org_name }} le ha inscrito en %(name)s en {{ platform_name }}. Complete "
"su registro para abrirlo."

#. Translators: %(address)s is the enrolled email address in bold.
msgid "Register with %(address)s: the place is for this address."
msgstr "Regístrese con %(address)s: la plaza es para esta dirección."

msgid ""
"You got this email because {{ org_name }} enrolled {{ email_address }}."
msgstr ""
"Recibe este correo electrónico porque {{ org_name }} inscribió a {{ "
"email_address }}."

msgid "You got this email because {{ org_name }} sent it to you."
msgstr ""
"Recibe este correo electrónico porque {{ org_name }} se lo ha enviado."

msgid "Mobile app crash reported"
msgstr "Fallo notificado en la aplicación móvil"

msgid "The {{ platform_name }} mobile app reported a crash."
msgstr "La aplicación móvil de {{ platform_name }} ha notificado un fallo."

msgid ""
"You got this email because it is the crash report address of {{ "
"platform_name }}."
msgstr ""
"Recibe este correo electrónico porque es la dirección de informes de fallos "
"de {{ platform_name }}."

msgid ""
"Your order for {{ order_summary }} is confirmed, and {{ tenant_name }} now "
"has an account at {{ org_name }}. Set up your sign-in to manage it."
msgstr ""
"Su pedido de {{ order_summary }} está confirmado y {{ tenant_name }} ya "
"tiene una cuenta en {{ org_name }}. Configure su inicio de sesión para "
"gestionarla."

msgid ""
"Once {{ org_name }} activates the account, you can invite your people, book "
"their sessions and follow their progress."
msgstr ""
"Cuando {{ org_name }} active la cuenta, podrá invitar a su personal, "
"reservar sus sesiones y seguir su progreso."

msgid "This link works until {{ expires_on }}."
msgstr "Este enlace funciona hasta el {{ expires_on }}."

msgid "You got this email because you bought seats for {{ tenant_name }}."
msgstr ""
"Recibe este correo electrónico porque compró plazas para {{ tenant_name }}."

#. Translators: {{ tenant_possessive }} is the company's name, possessive
#. ("Bolt Freight's"). You may
#. write {{ tenant_name }} instead, the name alone ("Bolt Freight"), where
#. your language puts it another way.
msgid ""
"{{ org_name }} recorded {{ tenant_possessive }} order for {{ order_summary "
"}}. We'll email the invoice to you."
msgstr ""
"{{ org_name }} ha registrado el pedido de {{ tenant_possessive }} de {{ "
"order_summary }}. Le enviaremos la factura por correo electrónico."

msgid ""
"Set up your sign-in to manage the seats. Once {{ org_name }} activates the "
"account, you can invite your people and book their sessions."
msgstr ""
"Configure su inicio de sesión para gestionar las plazas. Cuando {{ org_name "
"}} active la cuenta, podrá invitar a su personal y reservar sus sesiones."

msgid ""
"You got this email because {{ org_name }} recorded an order for {{ "
"tenant_name }}."
msgstr ""
"Recibe este correo electrónico porque {{ org_name }} registró un pedido para"
" {{ tenant_name }}."

#. Translators: {{ tenant_possessive }} is the company's name, possessive
#. ("Bolt Freight's"). You may
#. write {{ tenant_name }} instead, the name alone ("Bolt Freight"), where
#. your language puts it another way.
msgid ""
"{{ inviter_name }} invited you to manage {{ tenant_possessive }} account at "
"{{ org_name }} with them. Set up your sign-in to invite people, book their "
"sessions and follow their progress."
msgstr ""
"{{ inviter_name }} le ha invitado a gestionar con él la cuenta de {{ "
"tenant_possessive }} en {{ org_name }}. Configure su inicio de sesión para "
"invitar a personas, reservar sus sesiones y seguir su progreso."

msgid ""
"You got this email because {{ inviter_name }} invited you to manage {{ "
"tenant_name }}."
msgstr ""
"Recibe este correo electrónico porque {{ inviter_name }} le invitó a "
"gestionar {{ tenant_name }}."

msgid ""
"{{ org_name }} activated your account. You can have up to {{ learner_limit "
"}} people learning at once."
msgstr ""
"{{ org_name }} ha activado su cuenta. Puede tener hasta {{ learner_limit }} "
"personas aprendiendo a la vez."

#. Translators: {{ seats_summary }} is a whole sentence, such as "Your 20
#. seats in Fire safety are ready
#. to give out."
msgid "{{ seats_summary }} Invite your people, then book their sessions."
msgstr ""
"{{ seats_summary }} Invite a su personal y, después, reserve sus sesiones."

msgid "You got this email because you manage {{ tenant_name }}."
msgstr "Recibe este correo electrónico porque gestiona {{ tenant_name }}."

#. Translators: {{ tenant_possessive }} is the company's name, possessive
#. ("Bolt Freight's"). You may
#. write {{ tenant_name }} instead, the name alone ("Bolt Freight"), where
#. your language puts it another way.
msgid ""
"{{ org_name }} renewed {{ tenant_possessive }} contract until {{ "
"renewed_until }} with a learner limit of {{ learner_limit }}. You have {{ "
"active_learners }} people."
msgstr ""
"{{ org_name }} ha renovado el contrato de {{ tenant_possessive }} hasta el "
"{{ renewed_until }} con un límite de {{ learner_limit }} estudiantes. Tiene "
"{{ active_learners }} personas."

msgid ""
"Choose the {{ learner_limit }} who keep access before {{ choose_by }}. Until"
" you choose, everyone stays as they are now."
msgstr ""
"Elija a los {{ learner_limit }} que conservarán el acceso antes del {{ "
"choose_by }}. Hasta que elija, todos seguirán como están ahora."

msgid ""
"{{ org_name }} put {{ tenant_name }} on hold for payment on {{ changed_on "
"}}. Learning your company pays for is paused until this is cleared. "
"Everyone's progress and certificates are kept."
msgstr ""
"{{ org_name }} puso {{ tenant_name }} en espera de pago el {{ changed_on }}."
" El aprendizaje que paga su compañía está en pausa hasta que esto se "
"resuelva. El progreso y los certificados de todos se conservan."

msgid ""
"{{ org_name }} ended the payment hold on {{ tenant_name }} on {{ changed_on "
"}}. Your people can carry on with their learning."
msgstr ""
"{{ org_name }} finalizó la espera de pago de {{ tenant_name }} el {{ "
"changed_on }}. Su equipo puede continuar con su aprendizaje."

msgid ""
"{{ org_name }} blocked {{ tenant_name }} on {{ changed_on }}. Nobody can use"
" your company's account or the learning it pays for until it is unblocked."
msgstr ""
"{{ org_name }} bloqueó {{ tenant_name }} el {{ changed_on }}. Nadie puede "
"usar la cuenta de su compañía ni el aprendizaje que paga hasta que se "
"desbloquee."

msgid ""
"{{ org_name }} unblocked {{ tenant_name }} on {{ changed_on }}. You and your"
" people can sign in and carry on."
msgstr ""
"{{ org_name }} desbloqueó {{ tenant_name }} el {{ changed_on }}. Usted y su "
"equipo pueden iniciar sesión y continuar."

msgid ""
"{{ requester_name }}, who manages {{ tenant_name }}, asked on {{ "
"requested_on }} to renew the company's contract."
msgstr ""
"{{ requester_name }}, responsable de {{ tenant_name }}, solicitó el {{ "
"requested_on }} renovar el contrato de la compañía."

msgid "Renew the contract from the tenant's page."
msgstr "Renueve el contrato desde la página de la organización cliente."

msgid "You got this email because you can renew tenants at {{ org_name }}."
msgstr ""
"Recibe este correo electrónico porque puede renovar organizaciones cliente "
"en {{ org_name }}."

