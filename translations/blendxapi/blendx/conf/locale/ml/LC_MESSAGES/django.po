#. write {{ tenant_name }} instead, the name alone ("Bolt Freight"), where
#. your language puts it another way.
msgid "Set up your account to manage {{ tenant_possessive }} seats"
msgstr ""
"{{ tenant_possessive }} സീറ്റുകൾ കൈകാര്യം ചെയ്യാൻ നിങ്ങളുടെ അക്കൗണ്ട് "
