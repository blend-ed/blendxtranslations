msgid "Verified"
msgstr "സ്ഥിരീകരിച്ചു"

#. Translators: follows the learner's name, which the certificate shows on its
#. own line above; the sentence's subject is that name.
msgid ""
"has successfully completed and was awarded this certificate for the "
"programme above."
msgstr ""
"വിജയകരമായി പൂർത്തിയാക്കി, മുകളിലുള്ള പ്രോഗ്രാമിനുള്ള ഈ സർട്ടിഫിക്കറ്റ് നേടി."

msgid ""
"has successfully completed, received a passing grade, and was awarded this "
"certificate for the course above."
msgstr ""
"വിജയകരമായി പൂർത്തിയാക്കി, വിജയ ഗ്രേഡ് നേടി, മുകളിലുള്ള കോഴ്സിനുള്ള ഈ "
"സർട്ടിഫിക്കറ്റ് നേടി."

msgid "Issued on %(date)s"
msgstr "നൽകിയത്: %(date)s"

msgid "Valid until %(date)s"
msgstr "%(date)s വരെ സാധുതയുണ്ട്"

msgid "Sincerely,"
msgstr "വിശ്വസ്തതയോടെ,"

msgid "Supported by the following organizations"
msgstr "ഇനിപ്പറയുന്ന സ്ഥാപനങ്ങളുടെ പിന്തുണയോടെ"

msgid "Certificate of Attendance"
msgstr "ഹാജർ സർട്ടിഫിക്കറ്റ്"

msgid "Noted by"
msgstr "രേഖപ്പെടുത്തിയത്"

msgid "This certificate has been revoked"
msgstr "ഈ സർട്ടിഫിക്കറ്റ് റദ്ദാക്കിയിരിക്കുന്നു"

msgid ""
"The certificate for %(program)s was revoked on %(date)s. It is no longer "
"valid."
msgstr ""
"%(program)s-നുള്ള സർട്ടിഫിക്കറ്റ് %(date)s-ന് റദ്ദാക്കി. ഇത് ഇനി സാധുവല്ല."

#. Translators: follows the learner's name, which the certificate shows on its
#. own line above; the sentence's subject is that name.
msgid ""
"has successfully completed the programme %(program)s offered by %(org)s"
msgstr "%(org)s നൽകുന്ന %(program)s പ്രോഗ്രാം വിജയകരമായി പൂർത്തിയാക്കി"

msgid "Completed on %(date)s"
msgstr "%(date)s-ന് പൂർത്തിയാക്കി"

msgid "Courses:"
msgstr "കോഴ്സുകൾ:"

msgid "Verify this certificate at %(url)s"
msgstr "%(url)s-ൽ ഈ സർട്ടിഫിക്കറ്റ് സ്ഥിരീകരിക്കുക"

msgid "Certificate not found"
msgstr "സർട്ടിഫിക്കറ്റ് കണ്ടെത്തിയില്ല"

msgid "There is no valid certificate at this link."
msgstr "ഈ ലിങ്കിൽ സാധുവായ സർട്ടിഫിക്കറ്റൊന്നുമില്ല."

msgid "Certificate of competency"
msgstr "യോഗ്യതാ സർട്ടിഫിക്കറ്റ്"

msgid "Holder name"
msgstr "ഉടമയുടെ പേര്"

msgid "Competency"
msgstr "യോഗ്യത"

msgid "Knowledge"
msgstr "അറിവ്"

msgid "Role"
msgstr "റോൾ"

msgid "Field"
msgstr "ഫീൽഡ്"

msgid "Course"
msgstr "കോഴ്സ്"

msgid "Basis of training"
msgstr "പരിശീലനത്തിന്റെ അടിസ്ഥാനം"

msgid "Title"
msgstr "തലക്കെട്ട്"

msgid "Eligibility requirements"
msgstr "യോഗ്യതാ ആവശ്യകതകൾ"

msgid "Formal education"
msgstr "ഔപചാരിക വിദ്യാഭ്യാസം"

msgid "Professional experience"
msgstr "തൊഴിൽ പരിചയം"

msgid "Results"
msgstr "ഫലങ്ങൾ"

msgid "Certificate number"
msgstr "സർട്ടിഫിക്കറ്റ് നമ്പർ"

msgid "Initial certification"
msgstr "പ്രാരംഭ സർട്ടിഫിക്കേഷൻ"

msgid "This certificate"
msgstr "ഈ സർട്ടിഫിക്കറ്റ്"

msgid "Expiry Date"
msgstr "കാലാവധി തീരുന്ന തീയതി"

msgid "Knowledge certificates do not expire"
msgstr "അറിവ് സർട്ടിഫിക്കറ്റുകൾക്ക് കാലാവധി തീരില്ല"

msgid ""
"The certificate for %(session)s was revoked on %(date)s. It is no longer "
"valid."
msgstr ""
"%(session)s-നുള്ള സർട്ടിഫിക്കറ്റ് %(date)s-ന് റദ്ദാക്കി. ഇത് ഇനി സാധുവല്ല."

msgid "This certificate expired on %(date)s."
msgstr "ഈ സർട്ടിഫിക്കറ്റ് %(date)s-ന് കാലഹരണപ്പെട്ടു."

#. Translators: follows the learner's name, which the certificate shows on its
#. own line above; the sentence's subject is that name.
msgid "has successfully attended %(session)s offered by %(org)s"
msgstr "%(org)s നടത്തിയ %(session)s-ൽ വിജയകരമായി പങ്കെടുത്തു"

#. Translators: follows the learner's name, written large on the line above.
#. %(course_name)s is the course's name; keep the <span> around it (bold) and
#. the three <div>s (each is one line on the certificate).
msgid ""
"<div>has successfully completed the</div>\n"
"                    <div><span style=\"font-weight:600;\">%(course_name)s</span> course</div>\n"
"                    <div>at ACSF Level 3.</div>"
msgstr ""
"<div>ACSF ലെവൽ 3-ൽ</div>\n"
"                    <div><span style=\"font-weight:600;\">%(course_name)s</span> കോഴ്സ്</div>\n"
"                    <div>വിജയകരമായി പൂർത്തിയാക്കി.</div>"

#. Translators: %(when)s is a date and time, such as "17 November 2026 at
#. 09:30".
msgid ""
"The password for your account was changed on %(when)s UTC. If this wasn't "
"you, reset your password now and contact support."
msgstr ""
"നിങ്ങളുടെ അക്കൗണ്ടിന്റെ പാസ്‌വേഡ് %(when)s UTC-ക്ക് മാറ്റി. ഇത് "
"നിങ്ങളല്ലെങ്കിൽ, ഇപ്പോൾ തന്നെ നിങ്ങളുടെ പാസ്‌വേഡ് റീസെറ്റ് ചെയ്ത് "
"സപ്പോർട്ടിനെ ബന്ധപ്പെടുക."

msgid "Your password was changed"
msgstr "നിങ്ങളുടെ പാസ്‌വേഡ് മാറ്റി"

msgid "Password changed"
msgstr "പാസ്‌വേഡ് മാറ്റി"

msgid ""
"Confirms to the user that their account password was changed. Security "
"notice — cannot be disabled."
msgstr ""
"ഉപയോക്താവിന്റെ അക്കൗണ്ട് പാസ്‌വേഡ് മാറ്റിയെന്ന് അവരെ അറിയിക്കുന്നു. സുരക്ഷാ "
"അറിയിപ്പ് — പ്രവർത്തനരഹിതമാക്കാനാവില്ല."

msgid "Invitation — new user"
msgstr "ക്ഷണം — പുതിയ ഉപയോക്താവ്"

msgid "Invites an unregistered user to the platform."
msgstr ""
"രജിസ്റ്റർ ചെയ്യാത്ത ഒരു ഉപയോക്താവിനെ പ്ലാറ്റ്ഫോമിലേക്ക് ക്ഷണിക്കുന്നു."

msgid "Added to organisation"
msgstr "സ്ഥാപനത്തിലേക്ക് ചേർത്തു"

msgid "Sent when an existing platform user is added to the organisation."
msgstr ""
"നിലവിലുള്ള ഒരു പ്ലാറ്റ്ഫോം ഉപയോക്താവിനെ സ്ഥാപനത്തിലേക്ക് ചേർക്കുമ്പോൾ "
"അയയ്ക്കുന്നു."

msgid "Organisation + account created"
msgstr "സ്ഥാപനവും അക്കൗണ്ടും സൃഷ്ടിച്ചു"

msgid ""
"Sent when an organisation and its first account are created via the public "
"API."
msgstr ""
"പൊതു API വഴി ഒരു സ്ഥാപനവും അതിന്റെ ആദ്യ അക്കൗണ്ടും സൃഷ്ടിക്കുമ്പോൾ "
"അയയ്ക്കുന്നു."

msgid "Course enrollment — new user"
msgstr "കോഴ്സ് എൻറോൾമെന്റ് — പുതിയ ഉപയോക്താവ്"

msgid ""
"Sent when an unregistered user is enrolled in a course and must register "
"first."
msgstr ""
"രജിസ്റ്റർ ചെയ്യാത്ത ഒരു ഉപയോക്താവിനെ കോഴ്സിൽ എൻറോൾ ചെയ്യുകയും അവർ ആദ്യം "
"രജിസ്റ്റർ ചെയ്യേണ്ടി വരികയും ചെയ്യുമ്പോൾ അയയ്ക്കുന്നു."

msgid "Course enrollment — success"
msgstr "കോഴ്സ് എൻറോൾമെന്റ് — വിജയം"

msgid "Sent when a learner is enrolled in a course."
msgstr "ഒരു പഠിതാവിനെ കോഴ്സിൽ എൻറോൾ ചെയ്യുമ്പോൾ അയയ്ക്കുന്നു."

msgid "Course enrollment — update"
msgstr "കോഴ്സ് എൻറോൾമെന്റ് — അപ്ഡേറ്റ്"

msgid "Sent when a learner's enrollment changes."
msgstr "ഒരു പഠിതാവിന്റെ എൻറോൾമെന്റ് മാറുമ്പോൾ അയയ്ക്കുന്നു."

msgid "Program enrollment — success"
msgstr "പ്രോഗ്രാം എൻറോൾമെന്റ് — വിജയം"

msgid "Sent when a learner is enrolled in a program."
msgstr "ഒരു പഠിതാവിനെ പ്രോഗ്രാമിൽ എൻറോൾ ചെയ്യുമ്പോൾ അയയ്ക്കുന്നു."

msgid "Learner self-enrolled"
msgstr "പഠിതാവ് സ്വയം എൻറോൾ ചെയ്തു"

msgid ""
"Tells the course team that a learner enrolled themselves in their course. "
"Enrollments performed by staff are not announced — whoever ran them already "
"knows."
msgstr ""
"ഒരു പഠിതാവ് അവരുടെ കോഴ്സിൽ സ്വയം എൻറോൾ ചെയ്തുവെന്ന് കോഴ്സ് ടീമിനെ "
"അറിയിക്കുന്നു. സ്റ്റാഫ് നടത്തിയ എൻറോൾമെന്റുകൾ അറിയിക്കില്ല — അവ "
"നടത്തിയവർക്ക് ഇതിനകം അറിയാം."

msgid "Certificate earned"
msgstr "സർട്ടിഫിക്കറ്റ് ലഭിച്ചു"

msgid "Sent when a learner earns a course certificate."
msgstr "ഒരു പഠിതാവ് കോഴ്സ് സർട്ടിഫിക്കറ്റ് നേടുമ്പോൾ അയയ്ക്കുന്നു."

msgid ""
"Sent when a learner's certificate expires and their graded attempts are "
"reset."
msgstr ""
"ഒരു പഠിതാവിന്റെ സർട്ടിഫിക്കറ്റ് കാലഹരണപ്പെടുകയും ഗ്രേഡ് ചെയ്ത ശ്രമങ്ങൾ "
"റീസെറ്റ് ചെയ്യുകയും ചെയ്യുമ്പോൾ അയയ്ക്കുന്നു."

msgid "Guest purchase — success"
msgstr "അതിഥി വാങ്ങൽ — വിജയം"

msgid ""
"Receipt and access details for a guest checkout. Transactional — cannot be "
"disabled."
msgstr ""
"അതിഥി ചെക്ക്ഔട്ടിനുള്ള രസീതും ആക്സസ് വിവരങ്ങളും. ഇടപാട് സംബന്ധമായത് — "
"പ്രവർത്തനരഹിതമാക്കാനാവില്ല."

msgid "Payment failed"
msgstr "പേയ്മെന്റ് പരാജയപ്പെട്ടു"

msgid ""
"Warns a learner that a subscription payment failed and access will be "
"revoked. Transactional — cannot be disabled."
msgstr ""
"സബ്സ്ക്രിപ്ഷൻ പേയ്മെന്റ് പരാജയപ്പെട്ടുവെന്നും ആക്സസ് റദ്ദാക്കുമെന്നും "
"പഠിതാവിന് മുന്നറിയിപ്പ് നൽകുന്നു. ഇടപാട് സംബന്ധമായത് — "
"പ്രവർത്തനരഹിതമാക്കാനാവില്ല."

msgid "Purchase completed"
msgstr "വാങ്ങൽ പൂർത്തിയായി"

msgid ""
"Tells the course team that a learner bought their course, or the program "
"staff that a learner bought their program."
msgstr ""
"ഒരു പഠിതാവ് അവരുടെ കോഴ്സ് വാങ്ങിയെന്ന് കോഴ്സ് ടീമിനെ, അല്ലെങ്കിൽ ഒരു പഠിതാവ്"
" അവരുടെ പ്രോഗ്രാം വാങ്ങിയെന്ന് പ്രോഗ്രാം സ്റ്റാഫിനെ അറിയിക്കുന്നു."

msgid "Support ticket raised"
msgstr "സപ്പോർട്ട് ടിക്കറ്റ് ഉന്നയിച്ചു"

msgid "Notifies staff that a learner raised a support ticket."
msgstr ""
"ഒരു പഠിതാവ് സപ്പോർട്ട് ടിക്കറ്റ് ഉന്നയിച്ചുവെന്ന് സ്റ്റാഫിനെ അറിയിക്കുന്നു."

msgid "Support ticket status updated"
msgstr "സപ്പോർട്ട് ടിക്കറ്റിന്റെ നില അപ്ഡേറ്റ് ചെയ്തു"

msgid "Notifies the learner who raised a ticket that its status changed."
msgstr "ടിക്കറ്റിന്റെ നില മാറിയെന്ന് അത് ഉന്നയിച്ച പഠിതാവിനെ അറിയിക്കുന്നു."

msgid "Support ticket assigned"
msgstr "സപ്പോർട്ട് ടിക്കറ്റ് നൽകി"

msgid "Notifies a staff member that a ticket was assigned to them."
msgstr "ഒരു ടിക്കറ്റ് തങ്ങൾക്ക് നൽകിയെന്ന് സ്റ്റാഫ് അംഗത്തെ അറിയിക്കുന്നു."

msgid "Support ticket comment added"
msgstr "സപ്പോർട്ട് ടിക്കറ്റിൽ കമന്റ് ചേർത്തു"

msgid "Notifies the other party that a comment was added to a ticket."
msgstr "ടിക്കറ്റിൽ ഒരു കമന്റ് ചേർത്തുവെന്ന് മറുകക്ഷിയെ അറിയിക്കുന്നു."

msgid "Mobile crash alert"
msgstr "മൊബൈൽ ക്രാഷ് മുന്നറിയിപ്പ്"

msgid ""
"Internal crash report forwarded from the mobile app. Sent without an "
"organisation context."
msgstr ""
"മൊബൈൽ ആപ്പിൽ നിന്ന് കൈമാറിയ ആന്തരിക ക്രാഷ് റിപ്പോർട്ട്. സ്ഥാപന "
"സന്ദർഭമില്ലാതെ അയച്ചു."

msgid "Learner risk alert"
msgstr "പഠിതാവിനെക്കുറിച്ചുള്ള അപകടസാധ്യതാ മുന്നറിയിപ്പ്"

msgid "Nudge sent to a learner flagged as at risk of not completing a course."
msgstr ""
"കോഴ്സ് പൂർത്തിയാക്കാതിരിക്കാൻ സാധ്യതയുള്ളതായി അടയാളപ്പെടുത്തിയ പഠിതാവിന് "
"അയച്ച ഓർമ്മപ്പെടുത്തൽ."

msgid "Team notification"
msgstr "ടീം അറിയിപ്പ്"

msgid "In-app message sent to every member of a team."
msgstr "ഒരു ടീമിലെ എല്ലാ അംഗങ്ങൾക്കും അയയ്ക്കുന്ന ഇൻ-ആപ്പ് സന്ദേശം."

msgid "Custom broadcast"
msgstr "ഇഷ്ടാനുസൃത ബ്രോഡ്കാസ്റ്റ്"

msgid ""
"Ad-hoc announcement composed by staff. The sender picks the channels per "
"send; these settings cap what they may pick."
msgstr ""
"സ്റ്റാഫ് തയ്യാറാക്കുന്ന താൽക്കാലിക അറിയിപ്പ്. ഓരോ തവണ അയയ്ക്കുമ്പോഴും "
"അയയ്ക്കുന്നയാൾ ചാനലുകൾ തിരഞ്ഞെടുക്കുന്നു; അവർക്ക് തിരഞ്ഞെടുക്കാവുന്നതിന്റെ "
"പരിധി ഈ ക്രമീകരണങ്ങൾ നിശ്ചയിക്കുന്നു."

