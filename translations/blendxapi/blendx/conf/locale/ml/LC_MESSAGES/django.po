msgstr "അവർ ആവശ്യപ്പെട്ട തീയതി"

msgid "Tenant page link"
msgstr "ക്ലയന്റ് സ്ഥാപന പേജ് ലിങ്ക്"

msgid "Hi {{ full_name }},"
msgstr "നമസ്കാരം {{ full_name }},"

#. Translators: %(course)s is the course's name in bold.
msgid ""
"You have a place in %(course)s at {{ org_name }}. Open it any time from My "
"learning."
msgstr ""
"{{ org_name }}-ൽ %(course)s-ൽ നിങ്ങൾക്ക് ഒരു സ്ഥാനമുണ്ട്. എന്റെ പഠനം എന്നതിൽ"
" നിന്ന് എപ്പോൾ വേണമെങ്കിലും ഇത് തുറക്കാം."

msgid "You got this email because you were enrolled in {{ course_name }}."
msgstr ""
"നിങ്ങളെ {{ course_name }}-ൽ എൻറോൾ ചെയ്തതിനാലാണ് നിങ്ങൾക്ക് ഈ ഇമെയിൽ "
"ലഭിച്ചത്."

msgid "Your enrollment in {{ course_name }} changed"
msgstr "{{ course_name }}-ലെ നിങ്ങളുടെ എൻറോൾമെന്റ് മാറി"

#. Translators: %(course)s is the course's name in bold.
msgid ""
"Your access to %(course)s at {{ org_name }} changed. Open the course to see "
"what's new; you carry on from where you left off."
msgstr ""
"{{ org_name }}-ൽ %(course)s-ലേക്കുള്ള നിങ്ങളുടെ ആക്സസ് മാറി. പുതിയത് "
"എന്താണെന്ന് കാണാൻ കോഴ്സ് തുറക്കുക; നിങ്ങൾ നിർത്തിയിടത്ത് നിന്ന് തുടരാം."

msgid ""
"You got this email because your enrollment in {{ course_name }} changed."
msgstr ""
"{{ course_name }}-ലെ നിങ്ങളുടെ എൻറോൾമെന്റ് മാറിയതിനാലാണ് നിങ്ങൾക്ക് ഈ ഇമെയിൽ"
" ലഭിച്ചത്."

msgid "You earned your {{ course_name }} certificate"
msgstr "നിങ്ങൾ {{ course_name }} സർട്ടിഫിക്കറ്റ് നേടി"

#. Translators: %(course)s is the course's name in bold.
msgid ""
"Congratulations! You passed %(course)s at {{ org_name }} and earned its "
"certificate. You can view it, download it and share it."
msgstr ""
"അഭിനന്ദനങ്ങൾ! നിങ്ങൾ {{ org_name }}-ൽ %(course)s വിജയിച്ച് അതിന്റെ "
"സർട്ടിഫിക്കറ്റ് നേടി. നിങ്ങൾക്ക് അത് കാണാനും ഡൗൺലോഡ് ചെയ്യാനും പങ്കിടാനും "
"കഴിയും."

msgid "You got this email because you completed {{ course_name }}."
msgstr ""
"നിങ്ങൾ {{ course_name }} പൂർത്തിയാക്കിയതിനാലാണ് നിങ്ങൾക്ക് ഈ ഇമെയിൽ "
"ലഭിച്ചത്."

#. Translators: %(course)s is the course's name in bold; {{ expired_on }} is a
#. date.
msgid ""
"Your certificate for %(course)s at {{ org_name }} expired on {{ expired_on "
"}}."
msgstr ""
"{{ org_name }}-ൽ %(course)s-നുള്ള നിങ്ങളുടെ സർട്ടിഫിക്കറ്റ് {{ expired_on "
"}}-ന് കാലഹരണപ്പെട്ടു."

msgid ""
"Your graded attempts and scores for the course were reset, so you can start "
"fresh. Pass the assessments again and a new certificate is issued "
"automatically."
msgstr ""
"കോഴ്സിലെ നിങ്ങളുടെ ഗ്രേഡ് ചെയ്ത ശ്രമങ്ങളും സ്കോറുകളും റീസെറ്റ് ചെയ്തു, "
"അതിനാൽ നിങ്ങൾക്ക് പുതുതായി ആരംഭിക്കാം. മൂല്യനിർണ്ണയങ്ങൾ വീണ്ടും വിജയിച്ചാൽ "
"പുതിയ സർട്ടിഫിക്കറ്റ് സ്വയമേവ നൽകും."

msgid ""
"You got this email because you held a certificate for {{ course_name }}."
msgstr ""
"നിങ്ങൾക്ക് {{ course_name }}-നുള്ള സർട്ടിഫിക്കറ്റ് ഉണ്ടായിരുന്നതിനാലാണ് "
"നിങ്ങൾക്ക് ഈ ഇമെയിൽ ലഭിച്ചത്."

msgid "You're invited to join {{ display_name }}"
msgstr "{{ display_name }}-ൽ ചേരാൻ നിങ്ങളെ ക്ഷണിക്കുന്നു"

#. Translators: %(name)s is the organisation's or course's name in bold.
msgid ""
"You're invited to join %(name)s on {{ platform_name }}. Accept the "
"invitation to get started."
msgstr ""
"{{ platform_name }}-ൽ %(name)s-ൽ ചേരാൻ നിങ്ങളെ ക്ഷണിക്കുന്നു. ആരംഭിക്കാൻ "
"ക്ഷണം സ്വീകരിക്കുക."

#. Translators: %(address)s is the invited email address in bold.
msgid ""
"Sign in or register with %(address)s: the invitation is for this address."
msgstr ""
"%(address)s ഉപയോഗിച്ച് സൈൻ ഇൻ ചെയ്യുകയോ രജിസ്റ്റർ ചെയ്യുകയോ ചെയ്യുക: ക്ഷണം ഈ"
" വിലാസത്തിനുള്ളതാണ്."

msgid ""
"This link works until {{ expires_on }}. If a new invitation is sent, this "
"one stops working."
msgstr ""
"ഈ ലിങ്ക് {{ expires_on }} വരെ പ്രവർത്തിക്കും. പുതിയ ക്ഷണം അയച്ചാൽ, ഇത് "
"പ്രവർത്തനം നിർത്തും."

msgid ""
"You got this email because someone at {{ org_name }} invited {{ "
"email_address }}."
msgstr ""
"{{ org_name }}-ലെ ഒരാൾ {{ email_address }}-നെ ക്ഷണിച്ചതിനാലാണ് നിങ്ങൾക്ക് ഈ "
"ഇമെയിൽ ലഭിച്ചത്."

#. Translators: %(role)s is the role's name in bold.
msgid ""
"{{ inviter_name }} gave you the %(role)s role at {{ org_name }}. Sign in to "
"get started."
msgstr ""
"{{ inviter_name }} നിങ്ങൾക്ക് {{ org_name }}-ൽ %(role)s റോൾ നൽകി. ആരംഭിക്കാൻ"
" സൈൻ ഇൻ ചെയ്യുക."

msgid "You got this email because you were given a role at {{ org_name }}."
msgstr ""
"നിങ്ങൾക്ക് {{ org_name }}-ൽ ഒരു റോൾ നൽകിയതിനാലാണ് നിങ്ങൾക്ക് ഈ ഇമെയിൽ "
"ലഭിച്ചത്."

#. Translators: %(workspace)s is the new organisation's name in bold.
msgid ""
"Thanks for signing up for the AI Course Creator free trial on {{ "
"platform_name }}. Your workspace, %(workspace)s, is set up and your account "
"is active. Sign in to start building courses with AI."
msgstr ""
"{{ platform_name }}-ൽ AI കോഴ്സ് ക്രിയേറ്റർ സൗജന്യ ട്രയലിനായി സൈൻ അപ്പ് "
"ചെയ്തതിന് നന്ദി. നിങ്ങളുടെ വർക്ക്‌സ്‌പേസ്, %(workspace)s, സജ്ജീകരിച്ചു, "
"നിങ്ങളുടെ അക്കൗണ്ട് സജീവമാണ്. AI ഉപയോഗിച്ച് കോഴ്സുകൾ നിർമ്മിക്കാൻ ആരംഭിക്കാൻ"
" സൈൻ ഇൻ ചെയ്യുക."

#. Translators: %(address)s is the organisation's reply-to email address, as a
#. link.
msgid "Questions? Write to %(address)s."
msgstr "ചോദ്യങ്ങളുണ്ടോ? %(address)s-ലേക്ക് എഴുതുക."

msgid ""
"You got this email because you signed up for a free trial with {{ "
"email_address }}."
msgstr ""
"നിങ്ങൾ {{ email_address }} ഉപയോഗിച്ച് സൗജന്യ ട്രയലിനായി സൈൻ അപ്പ് "
"ചെയ്തതിനാലാണ് നിങ്ങൾക്ക് ഈ ഇമെയിൽ ലഭിച്ചത്."

msgid ""
"The password for your {{ platform_name }} account ({{ email_address }}) was "
"changed on {{ changed_at }}."
msgstr ""
"നിങ്ങളുടെ {{ platform_name }} അക്കൗണ്ടിന്റെ ({{ email_address }}) പാസ്‌വേഡ് "
"{{ changed_at }}-ന് മാറ്റി."

#. Translators: %(not_you)s is "Wasn't you?" in bold; %(address)s is the
#. reply-to email address, as a link.
msgid ""
"%(not_you)s Reset your password now from the sign-in page and contact "
"%(address)s."
msgstr ""
"%(not_you)s സൈൻ-ഇൻ പേജിൽ നിന്ന് ഇപ്പോൾ തന്നെ നിങ്ങളുടെ പാസ്‌വേഡ് റീസെറ്റ് "
"ചെയ്ത് %(address)s-നെ ബന്ധപ്പെടുക."

msgid "Wasn't you?"
msgstr "ഇത് നിങ്ങളല്ലേ?"

msgid ""
"You got this email because the password of your account changed. It can't be"
" switched off."
msgstr ""
"നിങ്ങളുടെ അക്കൗണ്ടിന്റെ പാസ്‌വേഡ് മാറിയതിനാലാണ് നിങ്ങൾക്ക് ഈ ഇമെയിൽ "
"ലഭിച്ചത്. ഇത് ഓഫാക്കാനാവില്ല."

msgid "{{ raised_by }} raised a ticket."
msgstr "{{ raised_by }} ഒരു ടിക്കറ്റ് ഉന്നയിച്ചു."

msgid "Type"
msgstr "തരം"

msgid ""
"You got this email because you get support ticket alerts at {{ org_name }}."
msgstr ""
"നിങ്ങൾക്ക് {{ org_name }}-ൽ സപ്പോർട്ട് ടിക്കറ്റ് മുന്നറിയിപ്പുകൾ "
"ലഭിക്കുന്നതിനാലാണ് നിങ്ങൾക്ക് ഈ ഇമെയിൽ ലഭിച്ചത്."

msgid "Claim your place at {{ org_name }}"
msgstr "{{ org_name }}-ൽ നിങ്ങളുടെ സ്ഥാനം ക്ലെയിം ചെയ്യുക"

msgid "Your place is waiting:"
msgstr "നിങ്ങളുടെ സ്ഥാനം കാത്തിരിക്കുന്നു:"

#. Translators: %(address)s is the buyer's email address in bold.
msgid ""
"Sign in or create an account with %(address)s, then claim your place: it is "
"for this address."
msgstr ""
"%(address)s ഉപയോഗിച്ച് സൈൻ ഇൻ ചെയ്യുകയോ അക്കൗണ്ട് സൃഷ്ടിക്കുകയോ ചെയ്ത ശേഷം "
"നിങ്ങളുടെ സ്ഥാനം ക്ലെയിം ചെയ്യുക: ഇത് ഈ വിലാസത്തിനുള്ളതാണ്."

msgid ""
"This link works until {{ expires_on }}. If you didn't ask for this, ignore "
"this email."
msgstr ""
"ഈ ലിങ്ക് {{ expires_on }} വരെ പ്രവർത്തിക്കും. നിങ്ങൾ ഇത് "
"ആവശ്യപ്പെട്ടിട്ടില്ലെങ്കിൽ, ഈ ഇമെയിൽ അവഗണിക്കുക."

msgid ""
"You got this email because a place at {{ org_name }} was requested for {{ "
"email_address }}."
msgstr ""
"{{ email_address }}-നായി {{ org_name }}-ൽ ഒരു സ്ഥാനം അഭ്യർത്ഥിച്ചതിനാലാണ് "
"നിങ്ങൾക്ക് ഈ ഇമെയിൽ ലഭിച്ചത്."

msgid "Thanks for your purchase"
msgstr "നിങ്ങളുടെ വാങ്ങലിന് നന്ദി"

msgid "Hi {{ first_name }},"
msgstr "നമസ്കാരം {{ first_name }},"

msgid ""
"Your payment to {{ org_name }} went through. Here is your receipt for order "
"{{ order_number }}, paid on {{ order_date }}."
msgstr ""
"{{ org_name }}-ലേക്കുള്ള നിങ്ങളുടെ പേയ്മെന്റ് വിജയിച്ചു. {{ order_date }}-ന്"
" പണം അടച്ച ഓർഡർ {{ order_number }}-ന്റെ രസീത് ഇതാ."

msgid "Paid by {{ payment_method }}. You can start learning now."
msgstr ""
"{{ payment_method }} വഴി പണം അടച്ചു. നിങ്ങൾക്ക് ഇപ്പോൾ പഠനം ആരംഭിക്കാം."

msgid ""
"You got this email because you bought {{ items }} on {{ platform_name }}."
msgstr ""
"നിങ്ങൾ {{ platform_name }}-ൽ {{ items }} വാങ്ങിയതിനാലാണ് നിങ്ങൾക്ക് ഈ ഇമെയിൽ"
" ലഭിച്ചത്."

#. Translators: {{ reason }} is the payment provider's sentence; %(amount)s is
#. the currency and amount in
#. bold; %(plan)s is the plan's name in bold.
msgid ""
"{{ reason }} We tried to take %(amount)s for %(plan)s and the payment didn't"
" go through, so your access has ended."
msgstr ""
"{{ reason }} %(plan)s-നായി %(amount)s ഈടാക്കാൻ ഞങ്ങൾ ശ്രമിച്ചു, പക്ഷേ "
"പേയ്മെന്റ് വിജയിച്ചില്ല, അതിനാൽ നിങ്ങളുടെ ആക്സസ് അവസാനിച്ചു."

msgid "Update your payment method to subscribe again."
msgstr ""
"വീണ്ടും സബ്സ്ക്രൈബ് ചെയ്യാൻ നിങ്ങളുടെ പേയ്മെന്റ് രീതി അപ്ഡേറ്റ് ചെയ്യുക."

msgid ""
"You got this email because you subscribe to {{ plan_name }} with {{ "
"email_address }}. It can't be switched off."
msgstr ""
"നിങ്ങൾ {{ email_address }} ഉപയോഗിച്ച് {{ plan_name }}-ലേക്ക് സബ്സ്ക്രൈബ് "
"ചെയ്തതിനാലാണ് നിങ്ങൾക്ക് ഈ ഇമെയിൽ ലഭിച്ചത്. ഇത് ഓഫാക്കാനാവില്ല."

#. Translators: %(name)s is the course's name in bold.
msgid ""
"{{ org_name }} enrolled you in %(name)s on {{ platform_name }}. Complete "
"your registration to open it."
msgstr ""
"{{ org_name }} നിങ്ങളെ {{ platform_name }}-ൽ %(name)s-ൽ എൻറോൾ ചെയ്തു. ഇത് "
"തുറക്കാൻ നിങ്ങളുടെ രജിസ്ട്രേഷൻ പൂർത്തിയാക്കുക."

#. Translators: %(address)s is the enrolled email address in bold.
msgid "Register with %(address)s: the place is for this address."
msgstr ""
"%(address)s ഉപയോഗിച്ച് രജിസ്റ്റർ ചെയ്യുക: സ്ഥാനം ഈ വിലാസത്തിനുള്ളതാണ്."

msgid ""
"You got this email because {{ org_name }} enrolled {{ email_address }}."
msgstr ""
"{{ org_name }} {{ email_address }}-നെ എൻറോൾ ചെയ്തതിനാലാണ് നിങ്ങൾക്ക് ഈ "
"ഇമെയിൽ ലഭിച്ചത്."

msgid "You got this email because {{ org_name }} sent it to you."
msgstr ""
"{{ org_name }} ഇത് നിങ്ങൾക്ക് അയച്ചതിനാലാണ് നിങ്ങൾക്ക് ഈ ഇമെയിൽ ലഭിച്ചത്."

msgid "Mobile app crash reported"
msgstr "മൊബൈൽ ആപ്പ് ക്രാഷ് റിപ്പോർട്ട് ചെയ്തു"

msgid "The {{ platform_name }} mobile app reported a crash."
msgstr "{{ platform_name }} മൊബൈൽ ആപ്പ് ഒരു ക്രാഷ് റിപ്പോർട്ട് ചെയ്തു."

msgid ""
"You got this email because it is the crash report address of {{ "
"platform_name }}."
msgstr ""
"ഇത് {{ platform_name }}-ന്റെ ക്രാഷ് റിപ്പോർട്ട് വിലാസമായതിനാലാണ് നിങ്ങൾക്ക് "
"ഈ ഇമെയിൽ ലഭിച്ചത്."

msgid ""
"Your order for {{ order_summary }} is confirmed, and {{ tenant_name }} now "
"has an account at {{ org_name }}. Set up your sign-in to manage it."
msgstr ""
"{{ order_summary }}-നുള്ള നിങ്ങളുടെ ഓർഡർ സ്ഥിരീകരിച്ചു, {{ tenant_name }}-ന്"
" ഇപ്പോൾ {{ org_name }}-ൽ ഒരു അക്കൗണ്ട് ഉണ്ട്. അത് കൈകാര്യം ചെയ്യാൻ നിങ്ങളുടെ"
" സൈൻ-ഇൻ സജ്ജീകരിക്കുക."

msgid ""
"Once {{ org_name }} activates the account, you can invite your people, book "
"their sessions and follow their progress."
msgstr ""
"{{ org_name }} അക്കൗണ്ട് സജീവമാക്കിയാൽ, നിങ്ങൾക്ക് നിങ്ങളുടെ ആളുകളെ "
"ക്ഷണിക്കാനും അവരുടെ സെഷനുകൾ ബുക്ക് ചെയ്യാനും അവരുടെ പുരോഗതി പിന്തുടരാനും "
"കഴിയും."

msgid "This link works until {{ expires_on }}."
msgstr "ഈ ലിങ്ക് {{ expires_on }} വരെ പ്രവർത്തിക്കും."

msgid "You got this email because you bought seats for {{ tenant_name }}."
msgstr ""
"നിങ്ങൾ {{ tenant_name }}-നായി സീറ്റുകൾ വാങ്ങിയതിനാലാണ് നിങ്ങൾക്ക് ഈ ഇമെയിൽ "
"ലഭിച്ചത്."

#. Translators: {{ tenant_possessive }} is the company's name, possessive
#. ("Bolt Freight's"). You may
#. write {{ tenant_name }} instead, the name alone ("Bolt Freight"), where
#. your language puts it another way.
msgid ""
"{{ org_name }} recorded {{ tenant_possessive }} order for {{ order_summary "
"}}. We'll email the invoice to you."
msgstr ""
"{{ org_name }} {{ order_summary }}-നുള്ള {{ tenant_possessive }} ഓർഡർ "
"രേഖപ്പെടുത്തി. ഞങ്ങൾ ഇൻവോയ്സ് നിങ്ങൾക്ക് ഇമെയിൽ ചെയ്യും."

msgid ""
"Set up your sign-in to manage the seats. Once {{ org_name }} activates the "
"account, you can invite your people and book their sessions."
msgstr ""
"സീറ്റുകൾ കൈകാര്യം ചെയ്യാൻ നിങ്ങളുടെ സൈൻ-ഇൻ സജ്ജീകരിക്കുക. {{ org_name }} "
"അക്കൗണ്ട് സജീവമാക്കിയാൽ, നിങ്ങൾക്ക് നിങ്ങളുടെ ആളുകളെ ക്ഷണിക്കാനും അവരുടെ "
"സെഷനുകൾ ബുക്ക് ചെയ്യാനും കഴിയും."

msgid ""
"You got this email because {{ org_name }} recorded an order for {{ "
"tenant_name }}."
msgstr ""
"{{ org_name }} {{ tenant_name }}-നായി ഒരു ഓർഡർ രേഖപ്പെടുത്തിയതിനാലാണ് "
"നിങ്ങൾക്ക് ഈ ഇമെയിൽ ലഭിച്ചത്."

#. Translators: {{ tenant_possessive }} is the company's name, possessive
#. ("Bolt Freight's"). You may
#. write {{ tenant_name }} instead, the name alone ("Bolt Freight"), where
#. your language puts it another way.
msgid ""
"{{ inviter_name }} invited you to manage {{ tenant_possessive }} account at "
"{{ org_name }} with them. Set up your sign-in to invite people, book their "
"sessions and follow their progress."
msgstr ""
"{{ org_name }}-ൽ {{ tenant_possessive }} അക്കൗണ്ട് തന്നോടൊപ്പം കൈകാര്യം "
"ചെയ്യാൻ {{ inviter_name }} നിങ്ങളെ ക്ഷണിച്ചു. ആളുകളെ ക്ഷണിക്കാനും അവരുടെ "
"സെഷനുകൾ ബുക്ക് ചെയ്യാനും അവരുടെ പുരോഗതി പിന്തുടരാനും നിങ്ങളുടെ സൈൻ-ഇൻ "
"സജ്ജീകരിക്കുക."

msgid ""
"You got this email because {{ inviter_name }} invited you to manage {{ "
"tenant_name }}."
msgstr ""
"{{ tenant_name }} കൈകാര്യം ചെയ്യാൻ {{ inviter_name }} നിങ്ങളെ "
"ക്ഷണിച്ചതിനാലാണ് നിങ്ങൾക്ക് ഈ ഇമെയിൽ ലഭിച്ചത്."

msgid ""
"{{ org_name }} activated your account. You can have up to {{ learner_limit "
"}} people learning at once."
msgstr ""
"{{ org_name }} നിങ്ങളുടെ അക്കൗണ്ട് സജീവമാക്കി. ഒരേ സമയം {{ learner_limit }} "
"പേർക്ക് വരെ പഠിക്കാം."

#. Translators: {{ seats_summary }} is a whole sentence, such as "Your 20
#. seats in Fire safety are ready
#. to give out."
msgid "{{ seats_summary }} Invite your people, then book their sessions."
msgstr ""
"{{ seats_summary }} നിങ്ങളുടെ ആളുകളെ ക്ഷണിക്കുക, തുടർന്ന് അവരുടെ സെഷനുകൾ "
"ബുക്ക് ചെയ്യുക."

msgid "You got this email because you manage {{ tenant_name }}."
msgstr ""
"നിങ്ങൾ {{ tenant_name }} കൈകാര്യം ചെയ്യുന്നതിനാലാണ് നിങ്ങൾക്ക് ഈ ഇമെയിൽ "
"ലഭിച്ചത്."

#. Translators: {{ tenant_possessive }} is the company's name, possessive
#. ("Bolt Freight's"). You may
#. write {{ tenant_name }} instead, the name alone ("Bolt Freight"), where
#. your language puts it another way.
msgid ""
"{{ org_name }} renewed {{ tenant_possessive }} contract until {{ "
"renewed_until }} with a learner limit of {{ learner_limit }}. You have {{ "
"active_learners }} people."
msgstr ""
"{{ org_name }} {{ tenant_possessive }} കരാർ {{ learner_limit }} പഠിതാക്കളുടെ"
" പരിധിയോടെ {{ renewed_until }} വരെ പുതുക്കി. നിങ്ങൾക്ക് {{ active_learners "
"}} പേരുണ്ട്."

msgid ""
"Choose the {{ learner_limit }} who keep access before {{ choose_by }}. Until"
" you choose, everyone stays as they are now."
msgstr ""
"{{ choose_by }}-ന് മുമ്പ് ആക്സസ് നിലനിർത്തേണ്ട {{ learner_limit }} പേരെ "
"തിരഞ്ഞെടുക്കുക. നിങ്ങൾ തിരഞ്ഞെടുക്കുന്നത് വരെ എല്ലാവരും ഇപ്പോഴത്തെ പോലെ "
"തുടരും."

msgid ""
"{{ org_name }} put {{ tenant_name }} on hold for payment on {{ changed_on "
"}}. Learning your company pays for is paused until this is cleared. "
"Everyone's progress and certificates are kept."
msgstr ""
"{{ org_name }} {{ changed_on }}-ന് {{ tenant_name }}-നെ പേയ്മെന്റിനായി "
"തടഞ്ഞുവെച്ചു. ഇത് തീർപ്പാക്കുന്നതുവരെ നിങ്ങളുടെ കമ്പനി പണമടയ്ക്കുന്ന പഠനം "
"താൽക്കാലികമായി നിർത്തിയിരിക്കുന്നു. എല്ലാവരുടെയും പുരോഗതിയും "
"സർട്ടിഫിക്കറ്റുകളും സൂക്ഷിച്ചിട്ടുണ്ട്."

msgid ""
"{{ org_name }} ended the payment hold on {{ tenant_name }} on {{ changed_on "
"}}. Your people can carry on with their learning."
msgstr ""
"{{ org_name }} {{ changed_on }}-ന് {{ tenant_name }}-ന്റെ പേയ്മെന്റ് "
"തടഞ്ഞുവയ്ക്കൽ അവസാനിപ്പിച്ചു. നിങ്ങളുടെ ആളുകൾക്ക് അവരുടെ പഠനം തുടരാം."

msgid ""
"{{ org_name }} blocked {{ tenant_name }} on {{ changed_on }}. Nobody can use"
" your company's account or the learning it pays for until it is unblocked."
msgstr ""
"{{ org_name }} {{ changed_on }}-ന് {{ tenant_name }} ബ്ലോക്ക് ചെയ്തു. "
"അൺബ്ലോക്ക് ചെയ്യുന്നതുവരെ നിങ്ങളുടെ കമ്പനിയുടെ അക്കൗണ്ടോ അത് പണമടയ്ക്കുന്ന "
"പഠനമോ ആർക്കും ഉപയോഗിക്കാനാകില്ല."

msgid ""
"{{ org_name }} unblocked {{ tenant_name }} on {{ changed_on }}. You and your"
" people can sign in and carry on."
msgstr ""
"{{ org_name }} {{ changed_on }}-ന് {{ tenant_name }} അൺബ്ലോക്ക് ചെയ്തു. "
"നിങ്ങൾക്കും നിങ്ങളുടെ ആളുകൾക്കും സൈൻ ഇൻ ചെയ്ത് തുടരാം."

msgid ""
"{{ requester_name }}, who manages {{ tenant_name }}, asked on {{ "
"requested_on }} to renew the company's contract."
msgstr ""
"{{ tenant_name }}-നെ നിയന്ത്രിക്കുന്ന {{ requester_name }} {{ requested_on "
"}}-ന് കമ്പനിയുടെ കരാർ പുതുക്കാൻ ആവശ്യപ്പെട്ടു."

msgid "Renew the contract from the tenant's page."
msgstr "ക്ലയന്റ് സ്ഥാപനത്തിന്റെ പേജിൽ നിന്ന് കരാർ പുതുക്കുക."

msgid "You got this email because you can renew tenants at {{ org_name }}."
msgstr ""
"{{ org_name }}-ൽ നിങ്ങൾക്ക് ക്ലയന്റ് സ്ഥാപനങ്ങളെ പുതുക്കാൻ കഴിയുന്നതിനാലാണ് "
"നിങ്ങൾക്ക് ഈ ഇമെയിൽ ലഭിച്ചത്."

msgid "your program"
msgstr "നിങ്ങളുടെ പ്രോഗ്രാം"

msgid "Your enrollment in %(title)s was updated"
msgstr "%(title)s-ലെ നിങ്ങളുടെ എൻറോൾമെന്റ് അപ്ഡേറ്റ് ചെയ്തു"

msgid "You're enrolled in %(title)s"
msgstr "നിങ്ങൾ %(title)s-ൽ എൻറോൾ ചെയ്തു"

msgid "Your access to %(title)s changed. Open the course to see what's new."
msgstr ""
"%(title)s-ലേക്കുള്ള നിങ്ങളുടെ ആക്സസ് മാറി. പുതിയത് എന്താണെന്ന് കാണാൻ കോഴ്സ് "
"തുറക്കുക."

msgid "You have a place in %(title)s. Open it from My learning."
msgstr ""
"%(title)s-ൽ നിങ്ങൾക്ക് ഒരു സ്ഥാനമുണ്ട്. എന്റെ പഠനം എന്നതിൽ നിന്ന് ഇത് "
"തുറക്കുക."

msgid "Go to my program"
msgstr "എന്റെ പ്രോഗ്രാമിലേക്ക് പോകുക"

msgid "You've earned your %(title)s certificate"
msgstr "നിങ്ങൾ %(title)s സർട്ടിഫിക്കറ്റ് നേടി"

msgid "Congratulations! You passed %(title)s and earned its certificate."
msgstr ""
"അഭിനന്ദനങ്ങൾ! നിങ്ങൾ %(title)s വിജയിച്ച് അതിന്റെ സർട്ടിഫിക്കറ്റ് നേടി."

msgid "You got this email because of your notification settings."
msgstr ""
"നിങ്ങളുടെ അറിയിപ്പ് ക്രമീകരണങ്ങൾ കാരണമാണ് നിങ്ങൾക്ക് ഈ ഇമെയിൽ ലഭിച്ചത്."

msgid "A learner"
msgstr "ഒരു പഠിതാവ്"

msgid "%(who)s completed %(title)s on a seat from %(tenant)s."
msgstr "%(who)s %(tenant)s-ൽ നിന്നുള്ള സീറ്റിൽ %(title)s പൂർത്തിയാക്കി."

msgid "%(who)s passed %(title)s on a seat from %(tenant)s."
msgstr "%(who)s %(tenant)s-ൽ നിന്നുള്ള സീറ്റിൽ %(title)s വിജയിച്ചു."

#. Translators: %(who)s is a learner's name; %(title)s a course or program.
msgid "%(who)s finished %(title)s"
msgstr "%(who)s %(title)s പൂർത്തിയാക്കി"

msgid "%(email)s hasn't accepted your invitation"
msgstr "%(email)s നിങ്ങളുടെ ക്ഷണം ഇതുവരെ സ്വീകരിച്ചിട്ടില്ല"

#. Translators: %(day)s is the date the invitation was sent.
msgid ""
"You invited %(email)s to learn with %(tenant)s on %(day)s, and they haven't "
"accepted yet. You can send the invitation again from People."
msgstr ""
"നിങ്ങൾ %(day)s-ന് %(tenant)s-നൊപ്പം പഠിക്കാൻ %(email)s-നെ ക്ഷണിച്ചു, അവർ "
"ഇതുവരെ സ്വീകരിച്ചിട്ടില്ല. ആളുകൾ എന്നതിൽ നിന്ന് നിങ്ങൾക്ക് ക്ഷണം വീണ്ടും "
"അയയ്ക്കാം."

msgid "a course"
msgstr "ഒരു കോഴ്സ്"

#. Translators: %(seats)s is a number of seats ("3 seats"); %(where)s what
#. they are for.
msgid "%(seats)s in %(where)s not given out yet"
msgstr "%(where)s-ൽ ഇതുവരെ നൽകാത്ത %(seats)s"

msgid ""
"%(tenant)s still has %(seats)s to give out in %(where)s. Enrollment closes "
"on %(day)s; seats not given by then can't be used."
msgstr ""
"%(tenant)s-ന് %(where)s-ൽ ഇനിയും %(seats)s നൽകാനുണ്ട്. എൻറോൾമെന്റ് "
"%(day)s-ന് അവസാനിക്കും; അതിനകം നൽകാത്ത സീറ്റുകൾ ഉപയോഗിക്കാനാവില്ല."

msgid "Order %(number)s is paid"
msgstr "ഓർഡർ %(number)s-ന് പണം അടച്ചു"

#. Translators: %(total)s is money with its currency; %(tenant)s a company.
msgid ""
"We received %(total)s for %(tenant)s's order %(number)s. Its seats are ready"
" to give out."
msgstr ""
"%(tenant)s-ന്റെ ഓർഡർ %(number)s-നായി ഞങ്ങൾക്ക് %(total)s ലഭിച്ചു. അതിന്റെ "
"സീറ്റുകൾ നൽകാൻ തയ്യാറാണ്."

msgid "%(tenant)s is ready"
msgstr "%(tenant)s തയ്യാറാണ്"

#. Translators: %(limit)s is a number of people.
msgid ""
"Your account is active. You can have up to %(limit)s people learning at "
"once."
msgstr ""
"നിങ്ങളുടെ അക്കൗണ്ട് സജീവമാണ്. ഒരേ സമയം %(limit)s പേർക്ക് വരെ പഠിക്കാം."

#. Translators: %(tenant)s is a company's name; %(limit)s is a number of
#. people.
msgid ""
"%(tenant)s's contract was renewed with a learner limit of %(limit)s. Choose "
"who keeps access."
msgstr ""
"%(tenant)s-ന്റെ കരാർ %(limit)s പഠിതാക്കളുടെ പരിധിയോടെ പുതുക്കി. ആക്സസ് "
"നിലനിർത്തേണ്ടവരെ തിരഞ്ഞെടുക്കുക."

#. Translators: %(tenant)s is a company's name.
msgid "%(tenant)s is on hold for payment"
msgstr "പേയ്മെന്റിനായി %(tenant)s തടഞ്ഞുവെച്ചിരിക്കുന്നു"

msgid ""
"Learning your company pays for is paused until this is cleared. Progress and"
" certificates are kept."
msgstr ""
"ഇത് തീർപ്പാക്കുന്നതുവരെ നിങ്ങളുടെ കമ്പനി പണമടയ്ക്കുന്ന പഠനം താൽക്കാലികമായി "
"നിർത്തിയിരിക്കുന്നു. പുരോഗതിയും സർട്ടിഫിക്കറ്റുകളും സൂക്ഷിച്ചിട്ടുണ്ട്."

#. Translators: %(tenant)s is a company's name.
msgid "%(tenant)s is no longer on hold"
msgstr "%(tenant)s ഇനി തടഞ്ഞുവെച്ചിട്ടില്ല"

msgid ""
"The payment hold has ended. Your people can carry on with their learning."
msgstr ""
"പേയ്മെന്റ് തടഞ്ഞുവയ്ക്കൽ അവസാനിച്ചു. നിങ്ങളുടെ ആളുകൾക്ക് അവരുടെ പഠനം തുടരാം."

#. Translators: %(tenant)s is a company's name.
msgid "%(tenant)s is blocked"
msgstr "%(tenant)s ബ്ലോക്ക് ചെയ്യപ്പെട്ടു"

msgid ""
"Nobody can use your company's account or the learning it pays for until it "
"is unblocked."
msgstr ""
"അൺബ്ലോക്ക് ചെയ്യുന്നതുവരെ നിങ്ങളുടെ കമ്പനിയുടെ അക്കൗണ്ടോ അത് പണമടയ്ക്കുന്ന "
"പഠനമോ ആർക്കും ഉപയോഗിക്കാനാകില്ല."

#. Translators: %(tenant)s is a company's name.
msgid "%(tenant)s is unblocked"
msgstr "%(tenant)s അൺബ്ലോക്ക് ചെയ്യപ്പെട്ടു"

msgid "You and your people can sign in and carry on."
msgstr "നിങ്ങൾക്കും നിങ്ങളുടെ ആളുകൾക്കും സൈൻ ഇൻ ചെയ്ത് തുടരാം."

#. Translators: %(tenant)s is a company's name.
msgid "%(tenant)s asks to renew"
msgstr "%(tenant)s പുതുക്കാൻ ആവശ്യപ്പെടുന്നു"

#. Translators: %(who)s is a person's name, %(tenant)s the company they manage
#. and %(note)s their own
#. message.
msgid ""
"%(who)s, who manages %(tenant)s, asked to renew the company's contract. "
"“%(note)s”"
msgstr ""
"%(tenant)s-നെ നിയന്ത്രിക്കുന്ന %(who)s കമ്പനിയുടെ കരാർ പുതുക്കാൻ "
"ആവശ്യപ്പെട്ടു. “%(note)s”"

#. Translators: %(who)s is a person's name; %(tenant)s is the company they
#. manage.
msgid ""
"%(who)s, who manages %(tenant)s, asked to renew the company's contract."
msgstr ""
"%(tenant)s-നെ നിയന്ത്രിക്കുന്ന %(who)s കമ്പനിയുടെ കരാർ പുതുക്കാൻ "
"ആവശ്യപ്പെട്ടു."

#. Translators: %(seats)s lists the seats, such as "20 seats in Fire safety
#. and 5 seats in First aid".
msgid "Your %(seats)s is ready to give out."
msgid_plural "Your %(seats)s are ready to give out."
msgstr[0] "നിങ്ങളുടെ %(seats)s നൽകാൻ തയ്യാറാണ്."
msgstr[1] "നിങ്ങളുടെ %(seats)s നൽകാൻ തയ്യാറാണ്."

msgid "An invoice is overdue."
msgstr "ഒരു ഇൻവോയ്സ് കാലാവധി കഴിഞ്ഞു."

msgid "The overdue invoice is settled."
msgstr "കാലാവധി കഴിഞ്ഞ ഇൻവോയ്സ് തീർപ്പാക്കി."

msgid "The reason given:"
msgstr "നൽകിയ കാരണം:"

msgid "Grades"
msgstr "ഗ്രേഡുകൾ"

msgid "Enrollments"
msgstr "എൻറോൾമെന്റുകൾ"

msgid "Certificates"
msgstr "സർട്ടിഫിക്കറ്റുകൾ"

msgid "Session attendance"
msgstr "സെഷൻ ഹാജർ"

msgid "Learner progress"
msgstr "പഠിതാവിന്റെ പുരോഗതി"

msgid "Every answer"
msgstr "ഓരോ ഉത്തരവും"

msgid "Submissions"
msgstr "സമർപ്പണങ്ങൾ"

msgid "Anonymous IDs"
msgstr "അജ്ഞാത ID-കൾ"

msgid "Video views"
msgstr "വീഡിയോ കാഴ്ചകൾ"

msgid "Assessment scores"
msgstr "മൂല്യനിർണ്ണയ സ്കോറുകൾ"

msgid "Invited, not enrolled"
msgstr "ക്ഷണിച്ചു, എൻറോൾ ചെയ്തിട്ടില്ല"

#. Translators: {report} is the report's name.
msgid "Your {report} report is ready"
msgstr "നിങ്ങളുടെ {report} റിപ്പോർട്ട് തയ്യാറാണ്"

#. Translators: {report} is the report's name.
msgid "The {report} report for this course is ready to download."
msgstr "ഈ കോഴ്സിന്റെ {report} റിപ്പോർട്ട് ഡൗൺലോഡ് ചെയ്യാൻ തയ്യാറാണ്."

msgid "Download the report"
msgstr "റിപ്പോർട്ട് ഡൗൺലോഡ് ചെയ്യുക"

msgid "Your data is ready to download"
msgstr "നിങ്ങളുടെ ഡാറ്റ ഡൗൺലോഡ് ചെയ്യാൻ തയ്യാറാണ്"

#. Translators: {days} is how many days the download link works.
msgid ""
"Your data is ready: one zip file of everything Blend-ed keeps. The link "
"works for {days} days, and only for you."
msgstr ""
"നിങ്ങളുടെ ഡാറ്റ തയ്യാറാണ്: Blend-ed സൂക്ഷിക്കുന്ന എല്ലാം ഉൾപ്പെട്ട ഒരു zip "
"ഫയൽ. ലിങ്ക് {days} ദിവസം, നിങ്ങൾക്ക് മാത്രം പ്രവർത്തിക്കും."

#. Translators: the title when the person whose data was exported no longer
#. has an account.
msgid "this person's data is ready to download"
msgstr "ഈ വ്യക്തിയുടെ ഡാറ്റ ഡൗൺലോഡ് ചെയ്യാൻ തയ്യാറാണ്"

#. Translators: the message when the person whose data was exported no longer
#. has an account; {days} is
#. how many days the link works.
msgid ""
"this person's data is ready: one zip file of everything Blend-ed keeps. The "
"link works for {days} days, and only for you."
msgstr ""
"ഈ വ്യക്തിയുടെ ഡാറ്റ തയ്യാറാണ്: Blend-ed സൂക്ഷിക്കുന്ന എല്ലാം ഉൾപ്പെട്ട ഒരു "
"zip ഫയൽ. ലിങ്ക് {days} ദിവസം, നിങ്ങൾക്ക് മാത്രം പ്രവർത്തിക്കും."

#. Translators: {name} is the person whose data was exported.
msgid "{name}'s data is ready to download"
msgstr "{name}-ന്റെ ഡാറ്റ ഡൗൺലോഡ് ചെയ്യാൻ തയ്യാറാണ്"

#. Translators: {name} is the person whose data was exported; {days} how many
#. days the link works.
msgid ""
"{name}'s data is ready: one zip file of everything Blend-ed keeps. The link "
"works for {days} days, and only for you."
msgstr ""
"{name}-ന്റെ ഡാറ്റ തയ്യാറാണ്: Blend-ed സൂക്ഷിക്കുന്ന എല്ലാം ഉൾപ്പെട്ട ഒരു zip"
" ഫയൽ. ലിങ്ക് {days} ദിവസം, നിങ്ങൾക്ക് മാത്രം പ്രവർത്തിക്കും."

msgid "Download the file"
msgstr "ഫയൽ ഡൗൺലോഡ് ചെയ്യുക"

msgid "Your full export is ready to download"
msgstr "നിങ്ങളുടെ പൂർണ്ണ എക്സ്പോർട്ട് ഡൗൺലോഡ് ചെയ്യാൻ തയ്യാറാണ്"

#. Translators: {days} is how many days the download link works.
msgid ""
"Your full export is ready: one zip file of your platform's records. The link"
" works for {days} days, and only for you."
msgstr ""
"നിങ്ങളുടെ പൂർണ്ണ എക്സ്പോർട്ട് തയ്യാറാണ്: നിങ്ങളുടെ പ്ലാറ്റ്ഫോമിന്റെ രേഖകൾ "
"ഉൾപ്പെട്ട ഒരു zip ഫയൽ. ലിങ്ക് {days} ദിവസം, നിങ്ങൾക്ക് മാത്രം "
"പ്രവർത്തിക്കും."

#. Translators: {report} is the report's name; {start} and {end} are dates
#. (YYYY-MM-DD).
msgid "The {report} report for {start} to {end} is ready to download."
msgstr ""
"{start} മുതൽ {end} വരെയുള്ള {report} റിപ്പോർട്ട് ഡൗൺലോഡ് ചെയ്യാൻ തയ്യാറാണ്."

#. Translators: {month} is the month just ended ("October 2026"); the others
#. are counts.
msgid ""
"{month}. Seats in use: {assigned} of {funded}. New seats: {new_seats}. "
"Results recorded: {results}. Certificates earned: {certificates}."
msgstr ""
"{month}. ഉപയോഗത്തിലുള്ള സീറ്റുകൾ: {funded}-ൽ {assigned}. പുതിയ സീറ്റുകൾ: "
"{new_seats}. രേഖപ്പെടുത്തിയ ഫലങ്ങൾ: {results}. നേടിയ സർട്ടിഫിക്കറ്റുകൾ: "
"{certificates}."

#. Translators: {end} is the week's last day, a Sunday ("22 November 2026");
#. the others are counts.
msgid ""
"Week to {end}. Seats in use: {assigned} of {funded}. New seats: {new_seats}."
" Results recorded: {results}. Certificates earned: {certificates}."
msgstr ""
"{end} വരെയുള്ള ആഴ്ച. ഉപയോഗത്തിലുള്ള സീറ്റുകൾ: {funded}-ൽ {assigned}. പുതിയ "
"സീറ്റുകൾ: {new_seats}. രേഖപ്പെടുത്തിയ ഫലങ്ങൾ: {results}. നേടിയ "
"സർട്ടിഫിക്കറ്റുകൾ: {certificates}."

#. Translators: {tenant} is the company's name.
msgid "{tenant}: your month in learning"
msgstr "{tenant}: പഠനത്തിലെ നിങ്ങളുടെ മാസം"

#. Translators: {tenant} is the company's name.
msgid "{tenant}: your week in learning"
msgstr "{tenant}: പഠനത്തിൽ നിങ്ങളുടെ ആഴ്ച"

#. Translators: {name} is the instructor's name; {title} is the session's
#. name.
msgid "{name} is away for {title}"
msgstr "{title}-ന് {name} ലഭ്യമല്ല"

#. Translators: {title} is the session's name, {when} the date's start and
#. {name} the instructor's name.
msgid ""
"{title} on {when} falls in {name}'s time off. They are still its instructor "
"until you change it."
msgstr ""
"{when}-ലെ {title} {name}-ന്റെ അവധിയിൽ വരുന്നു. നിങ്ങൾ മാറ്റുന്നത് വരെ അവർ "
"തന്നെയാണ് അതിന്റെ ഇൻസ്ട്രക്ടർ."

#. Translators: {title} is the session's name; the instructor's name is not
#. known.
msgid "An instructor is away for {title}"
msgstr "{title}-ന് ഒരു ഇൻസ്ട്രക്ടർ ലഭ്യമല്ല"

#. Translators: {title} is the session's name and {when} the date's start; the
#. instructor's name is not
#. known.
msgid ""
"{title} on {when} falls in the instructor's time off. They are still its "
"instructor until you change it."
msgstr ""
"{when}-നുള്ള {title} ഇൻസ്ട്രക്ടറുടെ അവധിയിലാണ് വരുന്നത്. നിങ്ങൾ "
"മാറ്റുന്നതുവരെ അവർ തന്നെയായിരിക്കും അതിന്റെ ഇൻസ്ട്രക്ടർ."

msgid "{name}, you earned a Session certificate!"
msgstr "{name}, നിങ്ങൾ ഒരു സെഷൻ സർട്ടിഫിക്കറ്റ് നേടി!"

#. Translators: {part} is the date's number within the session; {title} is the
#. session's name.
msgid "Part {part} of {title}"
msgstr "{title}-ന്റെ ഭാഗം {part}"

#. Translators: {by} is who moved the date; {title} the date's name; {when}
#. the new date and time, {was}
#. the old one.
msgid "{by} moved {title} to {when} (it was {was})."
msgstr "{by} {title} {when}-ലേക്ക് മാറ്റി (മുമ്പ് {was} ആയിരുന്നു)."

#. Translators: the whole message when no one is named; English leaves out who
#. did it. Write it as a
#. complete sentence ("{title} was moved to …"). {when} is the new date and
#. time, {was} the old one.
msgid "moved {title} to {when} (it was {was})."
msgstr "{title} {when}-ലേക്ക് മാറ്റി (മുമ്പ് {was} ആയിരുന്നു)."

msgid "{title} moved"
msgstr "{title} മാറ്റി"

#. Translators: {by} is who cancelled the date; {title} the date's name; {was}
#. the date and time it had.
msgid "{by} cancelled {title}, {was}."
msgstr "{by} {title}, {was} റദ്ദാക്കി."

#. Translators: the whole message when no one is named; English leaves out who
#. did it. Write it as a
#. complete sentence ("{title}, {was}, was cancelled."). {was} is the date and
#. time it had.
msgid "cancelled {title}, {was}."
msgstr "{title}, {was} റദ്ദാക്കി."

msgid "{title} cancelled"
msgstr "{title} റദ്ദാക്കി"

#. Translators: {by} is who added the instructor; {title} the date's name;
#. {when} its date and time.
msgid "{by} added you to {title}, {when}."
msgstr "{by} നിങ്ങളെ {title}, {when}-ലേക്ക് ചേർത്തു."

#. Translators: the whole message when no one is named; English leaves out who
#. did it. Write it as a
#. complete sentence ("You were added to {title}, {when}."). {when} is the
#. date and time.
msgid "added you to {title}, {when}."
msgstr "നിങ്ങളെ {title}, {when}-ലേക്ക് ചേർത്തു."

msgid "You're teaching {title}"
msgstr "നിങ്ങൾ {title} പഠിപ്പിക്കുന്നു"

#. Translators: {by} is who changed the date's instructors; {title} the date's
#. name; {was} its date and time.
msgid "{by} changed its instructors; {title} on {was} is not yours any more."
msgstr ""
"{by} അതിന്റെ ഇൻസ്ട്രക്ടർമാരെ മാറ്റി; {was}-ലെ {title} ഇനി നിങ്ങളുടേതല്ല."

#. Translators: the whole message when no one is named; English leaves out who
#. did it. Write it as a complete
#. sentence ("Its instructors changed; …"). {was} is the date and time.
msgid "changed its instructors; {title} on {was} is not yours any more."
msgstr "അതിന്റെ ഇൻസ്ട്രക്ടർമാരെ മാറ്റി; {was}-ലെ {title} ഇനി നിങ്ങളുടേതല്ല."

msgid "You're no longer teaching {title}"
msgstr "നിങ്ങൾ ഇനി {title} പഠിപ്പിക്കുന്നില്ല"

msgid "Confirm attendance for {title}"
msgstr "{title}-നുള്ള ഹാജർ സ്ഥിരീകരിക്കുക"

msgid "{title} has ended. Confirm who attended."
msgstr "{title} അവസാനിച്ചു. ആരൊക്കെ പങ്കെടുത്തുവെന്ന് സ്ഥിരീകരിക്കുക."

#. Translators: {title} is the session's name; {minutes} how many minutes
#. until it starts. English keeps
#. "minutes" even for 1.
msgid "{title} starts in {minutes} minutes"
msgid_plural "{title} starts in {minutes} minutes"
msgstr[0] "{title} {minutes} മിനിറ്റിനുള്ളിൽ ആരംഭിക്കും"
msgstr[1] "{title} {minutes} മിനിറ്റിനുള്ളിൽ ആരംഭിക്കും"

#. Translators: {title} is the session's name; {when} its start date and time.
msgid "{title} starts at {when}."
msgstr "{title} {when}-ന് ആരംഭിക്കും."

msgid "Tomorrow: {count} session"
msgid_plural "Tomorrow: {count} sessions"
msgstr[0] "നാളെ: {count} സെഷൻ"
msgstr[1] "നാളെ: {count} സെഷനുകൾ"

msgid "{count} new submission to review"
msgid_plural "{count} new submissions to review"
msgstr[0] "അവലോകനം ചെയ്യാൻ {count} പുതിയ സമർപ്പണം"
msgstr[1] "അവലോകനം ചെയ്യാൻ {count} പുതിയ സമർപ്പണങ്ങൾ"

#. Translators: {batch} is the batch's name; {count} how many submissions wait
#. for a grade.
msgid "{batch}: {count} submission waiting for a grade."
msgid_plural "{batch}: {count} submissions waiting for a grade."
msgstr[0] "{batch}: {count} സമർപ്പണം ഗ്രേഡിനായി കാത്തിരിക്കുന്നു."
msgstr[1] "{batch}: {count} സമർപ്പണങ്ങൾ ഗ്രേഡിനായി കാത്തിരിക്കുന്നു."

msgid "Weekly review due for {batches}"
msgstr "{batches}-നുള്ള പ്രതിവാര അവലോകനം നടത്തേണ്ട സമയമായി"

msgid "below the passing score"
msgstr "വിജയ സ്കോറിന് താഴെ"

msgid "not active for 14 days"
msgstr "14 ദിവസമായി സജീവമല്ല"

msgid "not active for 7 days"
msgstr "7 ദിവസമായി സജീവമല്ല"

msgid "behind on progress"
msgstr "പുരോഗതിയിൽ പിന്നിലാണ്"

msgid "has not started"
msgstr "ആരംഭിച്ചിട്ടില്ല"

msgid "failed an assessment"
msgstr "ഒരു മൂല്യനിർണ്ണയത്തിൽ പരാജയപ്പെട്ടു"

msgid "behind schedule"
msgstr "ഷെഡ്യൂളിന് പിന്നിൽ"

msgid "{name} needs help"
msgstr "{name}-ന് സഹായം ആവശ്യമാണ്"

#. Translators: {name} is the learner's name, {batch} the batch's and {why}
#. the reasons,
#. comma-separated.
msgid "{name} in {batch}: {why}."
msgstr "{batch}-ലെ {name}: {why}."

msgid "{title}: your date has moved"
msgstr "{title}: നിങ്ങളുടെ തീയതി മാറ്റി"

msgid "Your date of {title} now starts at {when}."
msgstr "{title}-ലെ നിങ്ങളുടെ തീയതി ഇപ്പോൾ {when}-ന് ആരംഭിക്കും."

msgid "{title}: your date is cancelled"
msgstr "{title}: നിങ്ങളുടെ തീയതി റദ്ദാക്കി"

msgid ""
"The date of {title} you had a place on is cancelled. You can book another "
"date."
msgstr ""
"നിങ്ങൾക്ക് സ്ഥാനമുണ്ടായിരുന്ന {title}-ന്റെ തീയതി റദ്ദാക്കി. നിങ്ങൾക്ക് "
"മറ്റൊരു തീയതി ബുക്ക് ചെയ്യാം."

msgid "{title}: you have a place"
msgstr "{title}: നിങ്ങൾക്ക് ഒരു സ്ഥാനമുണ്ട്"

msgid "A place freed on {title} and you are booked for {when}."
msgstr "{title}-ൽ ഒരു സ്ഥാനം ഒഴിവായി, നിങ്ങളെ {when}-ലേക്ക് ബുക്ക് ചെയ്തു."

#. Translators: {title} is the session's name; {count} how many hours until it
#. starts.
msgid "{title} starts in {count} hour"
msgid_plural "{title} starts in {count} hours"
msgstr[0] "{title} {count} മണിക്കൂറിനുള്ളിൽ ആരംഭിക്കും"
msgstr[1] "{title} {count} മണിക്കൂറിനുള്ളിൽ ആരംഭിക്കും"

#. Translators: {title} is the session's name.
msgid "{title} starts in 1 hour"
msgstr "{title} 1 മണിക്കൂറിനുള്ളിൽ ആരംഭിക്കും"

#. Translators: {title} is the session's name.
msgid "{title} starts in a few minutes"
msgstr "{title} ഏതാനും മിനിറ്റുകൾക്കുള്ളിൽ ആരംഭിക്കും"

#. Translators: {title} is the session's name; {count} how many minutes until
#. it starts (5 or more).
msgid "{title} starts in {count} minute"
msgid_plural "{title} starts in {count} minutes"
msgstr[0] "{title} {count} മിനിറ്റിനുള്ളിൽ ആരംഭിക്കും"
msgstr[1] "{title} {count} മിനിറ്റിനുള്ളിൽ ആരംഭിക്കും"

#. Translators: {title} is the session's name; {when} is its start date and
#. time.
msgid "Your booked date of {title} starts at {when}."
msgstr "{title}-ൽ നിങ്ങൾ ബുക്ക് ചെയ്ത തീയതി {when}-ന് ആരംഭിക്കും."

#. Translators: {name} is who raised it, {type} the ticket's type code (issue,
#. bug, feature, other) and {title}
#. its title.
msgid "{name} raised a new {type} ticket: {title}"
msgstr "{name} ഒരു പുതിയ {type} ടിക്കറ്റ് ഉന്നയിച്ചു: {title}"

msgid "New support ticket"
msgstr "പുതിയ സപ്പോർട്ട് ടിക്കറ്റ്"

msgid "Your support update"
msgstr "നിങ്ങളുടെ സപ്പോർട്ട് അപ്ഡേറ്റ്"

msgid "Your ticket {title} has been closed."
msgstr "നിങ്ങളുടെ ടിക്കറ്റ് {title} അടച്ചു."

msgid "Your ticket {title} has been reopened."
msgstr "നിങ്ങളുടെ ടിക്കറ്റ് {title} വീണ്ടും തുറന്നു."

msgid "Ticket assigned to you"
msgstr "ടിക്കറ്റ് നിങ്ങൾക്ക് നൽകി"

msgid "You have been assigned the ticket {title}."
msgstr "{title} എന്ന ടിക്കറ്റ് നിങ്ങൾക്ക് നൽകി."

#. Translators: {name} is who commented, {title} the ticket's title and
#. {comment} their words.
msgid "{name} commented on your ticket {title}: {comment}"
msgstr "{name} നിങ്ങളുടെ ടിക്കറ്റ് {title}-ൽ കമന്റ് ചെയ്തു: {comment}"

msgid "New comment on your ticket"
msgstr "നിങ്ങളുടെ ടിക്കറ്റിൽ പുതിയ കമന്റ്"
