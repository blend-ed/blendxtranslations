msgstr "ကုမ္ပဏီအကောင့် — ပိတ်ဆို့မှု ဖြုတ်ပြီး"

msgid ""
"Sent to a company's managers when the organization unblocks its account."
msgstr ""
"အဖွဲ့အစည်းက ကုမ္ပဏီ၏ အကောင့်ကို ပိတ်ဆို့မှု ဖြုတ်သည့်အခါ ၎င်း၏ "
"မန်နေဂျာများထံ ပို့သည်။"

msgid "{{ tenant_name }} is unblocked"
msgstr "{{ tenant_name }} ကို ပိတ်ဆို့မှု ဖြုတ်ပြီးပါပြီ"

msgid "Tenant — Asks to renew"
msgstr "ဖောက်သည်အဖွဲ့အစည်း — သက်တမ်းတိုးရန် တောင်းဆိုသည်"

msgid ""
"Sent to the people who can renew a tenant when its manager asks to renew."
msgstr ""
"ဖောက်သည်အဖွဲ့အစည်း၏ မန်နေဂျာက သက်တမ်းတိုးရန် တောင်းဆိုသည့်အခါ ၎င်းကို "
"သက်တမ်းတိုးနိုင်သူများထံ ပို့သည်။"

msgid "{{ tenant_name }} asks to renew"
msgstr "{{ tenant_name }} က သက်တမ်းတိုးရန် တောင်းဆိုသည်"

msgid "Open the tenant"
msgstr "ဖောက်သည်အဖွဲ့အစည်းကို ဖွင့်ရန်"

msgid "First name"
msgstr "ပထမအမည်"

msgid "The manager who asked"
msgstr "တောင်းဆိုခဲ့သော မန်နေဂျာ"

msgid "Date they asked"
msgstr "တောင်းဆိုခဲ့သည့်ရက်"

msgid "Tenant page link"
msgstr "ဖောက်သည်အဖွဲ့အစည်း စာမျက်နှာ လင့်ခ်"

msgid "Hi {{ full_name }},"
msgstr "မင်္ဂလာပါ {{ full_name }}၊"

#. Translators: %(course)s is the course's name in bold.
msgid ""
"You have a place in %(course)s at {{ org_name }}. Open it any time from My "
"learning."
msgstr ""
"{{ org_name }} ရှိ %(course)s တွင် သင့်နေရာ ရှိပါသည်။ ကျွန်ုပ်၏ သင်ယူမှုမှ "
"အချိန်မရွေး ဖွင့်နိုင်ပါသည်။"

msgid "You got this email because you were enrolled in {{ course_name }}."
msgstr ""
"{{ course_name }} တွင် သင့်ကို စာရင်းသွင်းခဲ့သောကြောင့် ဤအီးမေးလ်ကို "
"သင်ရရှိခြင်း ဖြစ်ပါသည်။"

msgid "Your enrollment in {{ course_name }} changed"
msgstr "{{ course_name }} တွင် သင့်စာရင်းသွင်းမှု ပြောင်းလဲသွားပါသည်"

#. Translators: %(course)s is the course's name in bold.
msgid ""
"Your access to %(course)s at {{ org_name }} changed. Open the course to see "
"what's new; you carry on from where you left off."
msgstr ""
"{{ org_name }} ရှိ %(course)s သို့ သင့်ဝင်ရောက်ခွင့် ပြောင်းလဲသွားပါသည်။ "
"အသစ်များကို ကြည့်ရန် သင်တန်းကို ဖွင့်ပါ။ သင်ရပ်ထားခဲ့သည့်နေရာမှ "
"ဆက်လုပ်နိုင်ပါသည်။"

msgid ""
"You got this email because your enrollment in {{ course_name }} changed."
msgstr ""
"{{ course_name }} တွင် သင့်စာရင်းသွင်းမှု ပြောင်းလဲခဲ့သောကြောင့် "
"ဤအီးမေးလ်ကို သင်ရရှိခြင်း ဖြစ်ပါသည်။"

msgid "You earned your {{ course_name }} certificate"
msgstr "သင်သည် {{ course_name }} လက်မှတ်ကို ရရှိခဲ့ပါပြီ"

#. Translators: %(course)s is the course's name in bold.
msgid ""
"Congratulations! You passed %(course)s at {{ org_name }} and earned its "
"certificate. You can view it, download it and share it."
msgstr ""
"ဂုဏ်ယူပါသည်။ သင်သည် {{ org_name }} တွင် %(course)s ကို အောင်မြင်ပြီး "
"၎င်း၏လက်မှတ်ကို ရရှိခဲ့ပါသည်။ ၎င်းကို ကြည့်ရှု၊ ဒေါင်းလုဒ်လုပ်ပြီး "
"မျှဝေနိုင်ပါသည်။"

msgid "You got this email because you completed {{ course_name }}."
msgstr ""
"{{ course_name }} ကို သင်ပြီးဆုံးခဲ့သောကြောင့် ဤအီးမေးလ်ကို သင်ရရှိခြင်း "
"ဖြစ်ပါသည်။"

#. Translators: %(course)s is the course's name in bold; {{ expired_on }} is a
#. date.
msgid ""
"Your certificate for %(course)s at {{ org_name }} expired on {{ expired_on "
"}}."
msgstr ""
"{{ org_name }} ရှိ %(course)s အတွက် သင့်လက်မှတ်သည် {{ expired_on }} တွင် "
"သက်တမ်းကုန်ခဲ့ပါသည်။"

msgid ""
"Your graded attempts and scores for the course were reset, so you can start "
"fresh. Pass the assessments again and a new certificate is issued "
"automatically."
msgstr ""
"သင်တန်းအတွက် သင့်အမှတ်ပေးကြိုးစားမှုများနှင့် အမှတ်များကို "
"ပြန်လည်သတ်မှတ်ထားသဖြင့် အသစ်မှ စတင်နိုင်ပါသည်။ အကဲဖြတ်ချက်များကို "
"ထပ်မံအောင်မြင်ပါက လက်မှတ်အသစ်ကို အလိုအလျောက် ထုတ်ပေးပါမည်။"

msgid ""
"You got this email because you held a certificate for {{ course_name }}."
msgstr ""
"{{ course_name }} အတွက် လက်မှတ်ကို သင်ကိုင်ဆောင်ခဲ့သောကြောင့် ဤအီးမေးလ်ကို "
"သင်ရရှိခြင်း ဖြစ်ပါသည်။"

msgid "You're invited to join {{ display_name }}"
msgstr "{{ display_name }} သို့ ပါဝင်ရန် သင့်ကို ဖိတ်ကြားထားပါသည်"

#. Translators: %(name)s is the organisation's or course's name in bold.
msgid ""
"You're invited to join %(name)s on {{ platform_name }}. Accept the "
"invitation to get started."
msgstr ""
"{{ platform_name }} တွင် %(name)s သို့ ပါဝင်ရန် သင့်ကို ဖိတ်ကြားထားပါသည်။ "
"စတင်ရန် ဖိတ်ကြားချက်ကို လက်ခံပါ။"

#. Translators: %(address)s is the invited email address in bold.
msgid ""
"Sign in or register with %(address)s: the invitation is for this address."
msgstr ""
"%(address)s ဖြင့် အကောင့်ဝင်ပါ သို့မဟုတ် မှတ်ပုံတင်ပါ- ဖိတ်ကြားချက်သည် "
"ဤလိပ်စာအတွက် ဖြစ်ပါသည်။"

msgid ""
"This link works until {{ expires_on }}. If a new invitation is sent, this "
"one stops working."
msgstr ""
"ဤလင့်ခ်သည် {{ expires_on }} အထိ အလုပ်လုပ်ပါသည်။ ဖိတ်ကြားချက်အသစ် ပို့ပါက "
"ဤလင့်ခ် အလုပ်မလုပ်တော့ပါ။"

msgid ""
"You got this email because someone at {{ org_name }} invited {{ "
"email_address }}."
msgstr ""
"{{ org_name }} မှ တစ်စုံတစ်ဦးက {{ email_address }} ကို ဖိတ်ကြားခဲ့သောကြောင့်"
" ဤအီးမေးလ်ကို သင်ရရှိခြင်း ဖြစ်ပါသည်။"

#. Translators: %(role)s is the role's name in bold.
msgid ""
"{{ inviter_name }} gave you the %(role)s role at {{ org_name }}. Sign in to "
"get started."
msgstr ""
"{{ inviter_name }} က {{ org_name }} တွင် သင့်ကို %(role)s အခန်းကဏ္ဍ "
"ပေးထားပါသည်။ စတင်ရန် အကောင့်ဝင်ပါ။"

msgid "You got this email because you were given a role at {{ org_name }}."
msgstr ""
"{{ org_name }} တွင် သင့်ကို အခန်းကဏ္ဍတစ်ခု ပေးအပ်ခဲ့သောကြောင့် ဤအီးမေးလ်ကို "
"သင်ရရှိခြင်း ဖြစ်ပါသည်။"

#. Translators: %(workspace)s is the new organisation's name in bold.
msgid ""
"Thanks for signing up for the AI Course Creator free trial on {{ "
"platform_name }}. Your workspace, %(workspace)s, is set up and your account "
"is active. Sign in to start building courses with AI."
msgstr ""
"{{ platform_name }} တွင် AI သင်တန်းဖန်တီးသူ အခမဲ့စမ်းသပ်မှုအတွက် "
"စာရင်းသွင်းသည့်အတွက် ကျေးဇူးတင်ပါသည်။ သင့်အလုပ်ခွင် %(workspace)s ကို "
"စီစဉ်သတ်မှတ်ပြီး သင့်အကောင့် အသက်ဝင်နေပါပြီ။ AI ဖြင့် သင်တန်းများ "
"စတင်တည်ဆောက်ရန် အကောင့်ဝင်ပါ။"

#. Translators: %(address)s is the organisation's reply-to email address, as a
#. link.
msgid "Questions? Write to %(address)s."
msgstr "မေးခွန်းများရှိပါသလား။ %(address)s သို့ စာရေးပါ။"

msgid ""
"You got this email because you signed up for a free trial with {{ "
"email_address }}."
msgstr ""
"{{ email_address }} ဖြင့် အခမဲ့စမ်းသပ်မှုအတွက် သင်စာရင်းသွင်းခဲ့သောကြောင့် "
"ဤအီးမေးလ်ကို သင်ရရှိခြင်း ဖြစ်ပါသည်။"

msgid ""
"The password for your {{ platform_name }} account ({{ email_address }}) was "
"changed on {{ changed_at }}."
msgstr ""
"သင့် {{ platform_name }} အကောင့် ({{ email_address }}) ၏ စကားဝှက်ကို {{ "
"changed_at }} တွင် ပြောင်းလဲခဲ့ပါသည်။"

#. Translators: %(not_you)s is "Wasn't you?" in bold; %(address)s is the
#. reply-to email address, as a link.
msgid ""
"%(not_you)s Reset your password now from the sign-in page and contact "
"%(address)s."
msgstr ""
"%(not_you)s အကောင့်ဝင်သည့်စာမျက်နှာမှ သင့်စကားဝှက်ကို ယခုပြန်လည်သတ်မှတ်ပြီး "
"%(address)s ကို ဆက်သွယ်ပါ။"

msgid "Wasn't you?"
msgstr "သင်မဟုတ်ပါသလား။"

msgid ""
"You got this email because the password of your account changed. It can't be"
" switched off."
msgstr ""
"သင့်အကောင့်၏ စကားဝှက် ပြောင်းလဲခဲ့သောကြောင့် ဤအီးမေးလ်ကို သင်ရရှိခြင်း "
"ဖြစ်ပါသည်။ ၎င်းကို ပိတ်၍မရပါ။"

msgid "{{ raised_by }} raised a ticket."
msgstr "{{ raised_by }} က တီကတ်တစ်ခု တင်သွင်းခဲ့သည်။"

msgid "Type"
msgstr "အမျိုးအစား"

msgid ""
"You got this email because you get support ticket alerts at {{ org_name }}."
msgstr ""
"{{ org_name }} တွင် အကူအညီ တီကတ် သတိပေးချက်များကို သင်လက်ခံရရှိသောကြောင့် "
"ဤအီးမေးလ်ကို သင်ရရှိခြင်း ဖြစ်ပါသည်။"

msgid "Claim your place at {{ org_name }}"
msgstr "{{ org_name }} တွင် သင့်နေရာကို ရယူပါ"

msgid "Your place is waiting:"
msgstr "သင့်နေရာ စောင့်နေပါသည်-"

#. Translators: %(address)s is the buyer's email address in bold.
msgid ""
"Sign in or create an account with %(address)s, then claim your place: it is "
"for this address."
msgstr ""
"%(address)s ဖြင့် အကောင့်ဝင်ပါ သို့မဟုတ် အကောင့်ဖန်တီးပါ၊ ထို့နောက် "
"သင့်နေရာကို ရယူပါ- ၎င်းသည် ဤလိပ်စာအတွက် ဖြစ်ပါသည်။"

msgid ""
"This link works until {{ expires_on }}. If you didn't ask for this, ignore "
"this email."
msgstr ""
"ဤလင့်ခ်သည် {{ expires_on }} အထိ အလုပ်လုပ်ပါသည်။ ဤအရာကို သင်မတောင်းဆိုခဲ့ပါက "
"ဤအီးမေးလ်ကို လျစ်လျူရှုပါ။"

msgid ""
"You got this email because a place at {{ org_name }} was requested for {{ "
"email_address }}."
msgstr ""
"{{ email_address }} အတွက် {{ org_name }} တွင် နေရာတစ်ခု "
"တောင်းဆိုခဲ့သောကြောင့် ဤအီးမေးလ်ကို သင်ရရှိခြင်း ဖြစ်ပါသည်။"

msgid "Thanks for your purchase"
msgstr "ဝယ်ယူသည့်အတွက် ကျေးဇူးတင်ပါသည်"

msgid "Hi {{ first_name }},"
msgstr "မင်္ဂလာပါ {{ first_name }}၊"

msgid ""
"Your payment to {{ org_name }} went through. Here is your receipt for order "
"{{ order_number }}, paid on {{ order_date }}."
msgstr ""
"{{ org_name }} သို့ သင့်ငွေပေးချေမှု အောင်မြင်ပါသည်။ {{ order_date }} တွင် "
"ပေးချေခဲ့သော မှာယူမှု {{ order_number }} အတွက် သင့်ပြေစာ ဖြစ်ပါသည်။"

msgid "Paid by {{ payment_method }}. You can start learning now."
msgstr "{{ payment_method }} ဖြင့် ပေးချေပြီးပါပြီ။ ယခု စတင်သင်ယူနိုင်ပါပြီ။"

msgid ""
"You got this email because you bought {{ items }} on {{ platform_name }}."
msgstr ""
"{{ platform_name }} တွင် {{ items }} ကို သင်ဝယ်ယူခဲ့သောကြောင့် ဤအီးမေးလ်ကို "
"သင်ရရှိခြင်း ဖြစ်ပါသည်။"

#. Translators: {{ reason }} is the payment provider's sentence; %(amount)s is
#. the currency and amount in
#. bold; %(plan)s is the plan's name in bold.
msgid ""
"{{ reason }} We tried to take %(amount)s for %(plan)s and the payment didn't"
" go through, so your access has ended."
msgstr ""
"{{ reason }} %(plan)s အတွက် %(amount)s ကို ကောက်ခံရန် ကြိုးစားခဲ့သော်လည်း "
"ငွေပေးချေမှု မအောင်မြင်သဖြင့် သင့်ဝင်ရောက်ခွင့် ရပ်ဆိုင်းသွားပါပြီ။"

msgid "Update your payment method to subscribe again."
msgstr "ပြန်လည်စာရင်းသွင်းရန် သင့်ငွေပေးချေမှုနည်းလမ်းကို အပ်ဒိတ်လုပ်ပါ။"

msgid ""
"You got this email because you subscribe to {{ plan_name }} with {{ "
"email_address }}. It can't be switched off."
msgstr ""
"{{ email_address }} ဖြင့် {{ plan_name }} ကို သင်ကြေးပေးသုံးစွဲနေသောကြောင့် "
"ဤအီးမေးလ်ကို သင်ရရှိခြင်း ဖြစ်ပါသည်။ ၎င်းကို ပိတ်၍မရပါ။"

#. Translators: %(name)s is the course's name in bold.
msgid ""
"{{ org_name }} enrolled you in %(name)s on {{ platform_name }}. Complete "
"your registration to open it."
msgstr ""
"{{ org_name }} က {{ platform_name }} တွင် %(name)s ၌ သင့်ကို "
"စာရင်းသွင်းထားပါသည်။ ၎င်းကို ဖွင့်ရန် သင့်မှတ်ပုံတင်ခြင်းကို ပြီးဆုံးပါ။"

#. Translators: %(address)s is the enrolled email address in bold.
msgid "Register with %(address)s: the place is for this address."
msgstr "%(address)s ဖြင့် မှတ်ပုံတင်ပါ- နေရာသည် ဤလိပ်စာအတွက် ဖြစ်ပါသည်။"

msgid ""
"You got this email because {{ org_name }} enrolled {{ email_address }}."
msgstr ""
"{{ org_name }} က {{ email_address }} ကို စာရင်းသွင်းခဲ့သောကြောင့် "
"ဤအီးမေးလ်ကို သင်ရရှိခြင်း ဖြစ်ပါသည်။"

msgid "You got this email because {{ org_name }} sent it to you."
msgstr ""
"{{ org_name }} က သင့်ထံ ပို့ခဲ့သောကြောင့် ဤအီးမေးလ်ကို သင်ရရှိခြင်း "
"ဖြစ်ပါသည်။"

msgid "Mobile app crash reported"
msgstr "မိုဘိုင်းအက်ပ် ပျက်ကျမှု တိုင်ကြားထားသည်"

msgid "The {{ platform_name }} mobile app reported a crash."
msgstr ""
"{{ platform_name }} မိုဘိုင်းအက်ပ်က ပျက်ကျမှုတစ်ခုကို တိုင်ကြားခဲ့သည်။"

msgid ""
"You got this email because it is the crash report address of {{ "
"platform_name }}."
msgstr ""
"၎င်းသည် {{ platform_name }} ၏ ပျက်ကျမှု အစီရင်ခံစာ လိပ်စာဖြစ်သောကြောင့် "
"ဤအီးမေးလ်ကို သင်ရရှိခြင်း ဖြစ်ပါသည်။"

msgid ""
"Your order for {{ order_summary }} is confirmed, and {{ tenant_name }} now "
"has an account at {{ org_name }}. Set up your sign-in to manage it."
msgstr ""
"{{ order_summary }} အတွက် သင့်မှာယူမှုကို အတည်ပြုပြီးဖြစ်ပြီး {{ tenant_name"
" }} တွင် ယခု {{ org_name }} ၌ အကောင့်တစ်ခု ရှိပါပြီ။ ၎င်းကို စီမံရန် "
"သင့်အကောင့်ဝင်ခြင်းကို စီစဉ်သတ်မှတ်ပါ။"

msgid ""
"Once {{ org_name }} activates the account, you can invite your people, book "
"their sessions and follow their progress."
msgstr ""
"{{ org_name }} က အကောင့်ကို အသက်သွင်းပြီးသည်နှင့် သင့်လူများကို "
"ဖိတ်ကြားခြင်း၊ ၎င်းတို့၏ စာသင်ချိန်များကို ကြိုတင်စာရင်းသွင်းခြင်းနှင့် "
"၎င်းတို့၏ တိုးတက်မှုကို စောင့်ကြည့်ခြင်းတို့ ပြုလုပ်နိုင်ပါသည်။"

msgid "This link works until {{ expires_on }}."
msgstr "ဤလင့်ခ်သည် {{ expires_on }} အထိ အလုပ်လုပ်ပါသည်။"

msgid "You got this email because you bought seats for {{ tenant_name }}."
msgstr ""
"{{ tenant_name }} အတွက် နေရာများကို သင်ဝယ်ယူခဲ့သောကြောင့် ဤအီးမေးလ်ကို "
"သင်ရရှိခြင်း ဖြစ်ပါသည်။"

#. Translators: {{ tenant_possessive }} is the company's name, possessive
#. ("Bolt Freight's"). You may
#. write {{ tenant_name }} instead, the name alone ("Bolt Freight"), where
#. your language puts it another way.
msgid ""
"{{ org_name }} recorded {{ tenant_possessive }} order for {{ order_summary "
"}}. We'll email the invoice to you."
msgstr ""
"{{ org_name }} က {{ order_summary }} အတွက် {{ tenant_possessive }} "
"မှာယူမှုကို မှတ်တမ်းတင်ထားပါသည်။ ငွေတောင်းခံလွှာကို သင့်ထံ "
"အီးမေးလ်ပို့ပါမည်။"

msgid ""
"Set up your sign-in to manage the seats. Once {{ org_name }} activates the "
"account, you can invite your people and book their sessions."
msgstr ""
"နေရာများကို စီမံရန် သင့်အကောင့်ဝင်ခြင်းကို စီစဉ်သတ်မှတ်ပါ။ {{ org_name }} က "
"အကောင့်ကို အသက်သွင်းပြီးသည်နှင့် သင့်လူများကို ဖိတ်ကြားပြီး ၎င်းတို့၏ "
"စာသင်ချိန်များကို ကြိုတင်စာရင်းသွင်းနိုင်ပါသည်။"

msgid ""
"You got this email because {{ org_name }} recorded an order for {{ "
"tenant_name }}."
msgstr ""
"{{ org_name }} က {{ tenant_name }} အတွက် မှာယူမှုတစ်ခုကို "
"မှတ်တမ်းတင်ခဲ့သောကြောင့် ဤအီးမေးလ်ကို သင်ရရှိခြင်း ဖြစ်ပါသည်။"

#. Translators: {{ tenant_possessive }} is the company's name, possessive
#. ("Bolt Freight's"). You may
#. write {{ tenant_name }} instead, the name alone ("Bolt Freight"), where
#. your language puts it another way.
msgid ""
"{{ inviter_name }} invited you to manage {{ tenant_possessive }} account at "
"{{ org_name }} with them. Set up your sign-in to invite people, book their "
"sessions and follow their progress."
msgstr ""
"{{ inviter_name }} က {{ org_name }} ရှိ {{ tenant_possessive }} အကောင့်ကို "
"၎င်းနှင့်အတူ စီမံရန် သင့်ကို ဖိတ်ကြားထားပါသည်။ လူများကို ဖိတ်ကြားရန်၊ "
"၎င်းတို့၏ စာသင်ချိန်များကို ကြိုတင်စာရင်းသွင်းရန်နှင့် ၎င်းတို့၏ "
"တိုးတက်မှုကို စောင့်ကြည့်ရန် သင့်အကောင့်ဝင်ခြင်းကို စီစဉ်သတ်မှတ်ပါ။"

msgid ""
"You got this email because {{ inviter_name }} invited you to manage {{ "
"tenant_name }}."
msgstr ""
"{{ inviter_name }} က {{ tenant_name }} ကို စီမံရန် သင့်ကို "
"ဖိတ်ကြားခဲ့သောကြောင့် ဤအီးမေးလ်ကို သင်ရရှိခြင်း ဖြစ်ပါသည်။"

msgid ""
"{{ org_name }} opened an AI Suite space for {{ tenant_name }}. Set up your "
"sign-in to build courses with AI Studio and export them."
msgstr ""
"{{ org_name }} က {{ tenant_name }} အတွက် AI Suite နေရာကို ဖွင့်ပေးပါပြီ။ AI "
"Studio ဖြင့် သင်တန်းများ တည်ဆောက်ပြီး ထုတ်ယူရန် သင့်အကောင့်ဝင်ခြင်းကို "
"စီစဉ်သတ်မှတ်ပါ။"

msgid ""
"You got this email because {{ org_name }} opened an AI Suite space for {{ "
"email_address }}."
msgstr ""
"{{ org_name }} က {{ email_address }} အတွက် AI Suite နေရာကို "
"ဖွင့်ပေးသောကြောင့် ဤအီးမေးလ်ကို ရရှိခြင်း ဖြစ်ပါသည်။"

msgid ""
"The free trial for {{ tenant_name }} ends on {{ ends_on }}. After that you "
"can't build or edit courses, and on {{ deletes_on }} its courses are "
"deleted."
msgstr ""
"{{ tenant_name }} အတွက် အခမဲ့စမ်းသပ်မှုသည် {{ ends_on }} တွင် ပြီးဆုံးပါမည်။"
" ထို့နောက် သင်တန်းများကို တည်ဆောက်ခြင်း သို့မဟုတ် ပြင်ဆင်ခြင်း "
"မပြုနိုင်တော့ဘဲ {{ deletes_on }} တွင် ၎င်း၏ သင်တန်းများကို ဖျက်ပါမည်။"

msgid ""
"Export the courses you want to keep before then, or contact {{ org_name }} "
"to keep using AI Suite."
msgstr ""
"ထိုမတိုင်မီ သိမ်းထားလိုသော သင်တန်းများကို ထုတ်ယူပါ သို့မဟုတ် AI Suite ကို "
"ဆက်သုံးရန် {{ org_name }} ကို ဆက်သွယ်ပါ။"

msgid ""
"You got this email because you manage {{ tenant_name }}'s AI Suite space."
msgstr ""
"သင်သည် {{ tenant_name }} ၏ AI Suite နေရာကို စီမံသောကြောင့် ဤအီးမေးလ်ကို "
"ရရှိခြင်း ဖြစ်ပါသည်။"

msgid ""
"{{ org_name }} activated your account. You can have up to {{ learner_limit "
"}} people learning at once."
msgstr ""
"{{ org_name }} က သင့်အကောင့်ကို အသက်သွင်းလိုက်ပါပြီ။ တစ်ပြိုင်နက် လူ {{ "
"learner_limit }} ဦးအထိ သင်ယူနိုင်ပါသည်။"

#. Translators: {{ seats_summary }} is a whole sentence, such as "Your 20
#. seats in Fire safety are ready
#. to give out."
msgid "{{ seats_summary }} Invite your people, then book their sessions."
msgstr ""
"{{ seats_summary }} သင့်လူများကို ဖိတ်ကြားပြီး ၎င်းတို့၏ စာသင်ချိန်များကို "
"ကြိုတင်စာရင်းသွင်းပါ။"

msgid "You got this email because you manage {{ tenant_name }}."
msgstr ""
"{{ tenant_name }} ကို သင်စီမံသောကြောင့် ဤအီးမေးလ်ကို သင်ရရှိခြင်း ဖြစ်ပါသည်။"

#. Translators: {{ tenant_possessive }} is the company's name, possessive
#. ("Bolt Freight's"). You may
#. write {{ tenant_name }} instead, the name alone ("Bolt Freight"), where
#. your language puts it another way.
msgid ""
"{{ org_name }} renewed {{ tenant_possessive }} contract until {{ "
"renewed_until }} with a learner limit of {{ learner_limit }}. You have {{ "
"active_learners }} people."
msgstr ""
"{{ org_name }} က {{ tenant_possessive }} စာချုပ်ကို သင်ယူသူ ကန့်သတ်ချက် {{ "
"learner_limit }} ဖြင့် {{ renewed_until }} အထိ သက်တမ်းတိုးထားပါသည်။ သင့်တွင်"
" လူ {{ active_learners }} ဦး ရှိပါသည်။"

msgid ""
"Choose the {{ learner_limit }} who keep access before {{ choose_by }}. Until"
" you choose, everyone stays as they are now."
msgstr ""
"{{ choose_by }} မတိုင်မီ ဝင်ရောက်ခွင့် ဆက်ရှိမည့် {{ learner_limit }} ဦးကို "
"ရွေးချယ်ပါ။ သင်မရွေးချယ်မချင်း လူတိုင်း ယခုအတိုင်း ဆက်ရှိနေပါမည်။"

msgid ""
"{{ org_name }} put {{ tenant_name }} on hold for payment on {{ changed_on "
"}}. Learning your company pays for is paused until this is cleared. "
"Everyone's progress and certificates are kept."
msgstr ""
"{{ org_name }} က {{ changed_on }} တွင် {{ tenant_name }} ကို "
"ငွေပေးချေမှုအတွက် ဆိုင်းငံ့ခဲ့သည်။ ဤကိစ္စ မရှင်းမချင်း သင့်ကုမ္ပဏီက "
"ပေးချေသော သင်ယူမှုကို ခေတ္တရပ်ထားပါသည်။ လူတိုင်း၏ တိုးတက်မှုနှင့် "
"လက်မှတ်များကို ဆက်ထားပါသည်။"

msgid ""
"{{ org_name }} ended the payment hold on {{ tenant_name }} on {{ changed_on "
"}}. Your people can carry on with their learning."
msgstr ""
"{{ org_name }} က {{ changed_on }} တွင် {{ tenant_name }} ပေါ်ရှိ "
"ငွေပေးချေမှု ဆိုင်းငံ့ခြင်းကို ရပ်ခဲ့သည်။ သင့်လူများ ၎င်းတို့၏ သင်ယူမှုကို "
"ဆက်လုပ်နိုင်ပါပြီ။"

msgid ""
"{{ org_name }} blocked {{ tenant_name }} on {{ changed_on }}. Nobody can use"
" your company's account or the learning it pays for until it is unblocked."
msgstr ""
"{{ org_name }} က {{ changed_on }} တွင် {{ tenant_name }} ကို ပိတ်ဆို့ခဲ့သည်။"
" ပိတ်ဆို့မှု မဖြုတ်မချင်း သင့်ကုမ္ပဏီ၏ အကောင့် သို့မဟုတ် ၎င်းက ပေးချေသော "
"သင်ယူမှုကို မည်သူမျှ အသုံးမပြုနိုင်ပါ။"

msgid ""
"{{ org_name }} unblocked {{ tenant_name }} on {{ changed_on }}. You and your"
" people can sign in and carry on."
msgstr ""
"{{ org_name }} က {{ changed_on }} တွင် {{ tenant_name }} ကို ပိတ်ဆို့မှု "
"ဖြုတ်ခဲ့သည်။ သင်နှင့် သင့်လူများ အကောင့်ဝင်ပြီး ဆက်လုပ်နိုင်ပါပြီ။"

msgid ""
"{{ requester_name }}, who manages {{ tenant_name }}, asked on {{ "
"requested_on }} to renew the company's contract."
msgstr ""
"{{ tenant_name }} ကို စီမံသူ {{ requester_name }} က {{ requested_on }} တွင် "
"ကုမ္ပဏီ၏ စာချုပ်ကို သက်တမ်းတိုးရန် တောင်းဆိုခဲ့သည်။"

msgid "Renew the contract from the tenant's page."
msgstr "ဖောက်သည်အဖွဲ့အစည်း၏ စာမျက်နှာမှ စာချုပ်ကို သက်တမ်းတိုးပါ။"

msgid "You got this email because you can renew tenants at {{ org_name }}."
msgstr ""
"{{ org_name }} တွင် ဖောက်သည်အဖွဲ့အစည်းများကို သက်တမ်းတိုးနိုင်သောကြောင့် သင်"
" ဤအီးမေးလ်ကို ရရှိပါသည်။"

msgid "your program"
msgstr "သင့်ပရိုဂရမ်"

msgid "Your enrollment in %(title)s was updated"
msgstr "%(title)s တွင် သင့်စာရင်းသွင်းမှုကို အပ်ဒိတ်လုပ်ပြီးပါပြီ"

msgid "You're enrolled in %(title)s"
msgstr "သင်သည် %(title)s တွင် စာရင်းသွင်းပြီးပါပြီ"

msgid "Your access to %(title)s changed. Open the course to see what's new."
msgstr ""
"%(title)s သို့ သင့်ဝင်ရောက်ခွင့် ပြောင်းလဲသွားပါသည်။ အသစ်များကို ကြည့်ရန် "
"သင်တန်းကို ဖွင့်ပါ။"

msgid "You have a place in %(title)s. Open it from My learning."
msgstr "%(title)s တွင် သင့်နေရာ ရှိပါသည်။ ကျွန်ုပ်၏ သင်ယူမှုမှ ဖွင့်ပါ။"

msgid "Go to my program"
msgstr "ကျွန်ုပ်၏ ပရိုဂရမ်သို့ သွားရန်"

msgid "You've earned your %(title)s certificate"
msgstr "သင်သည် %(title)s လက်မှတ်ကို ရရှိခဲ့ပါပြီ"

msgid "Congratulations! You passed %(title)s and earned its certificate."
msgstr ""
"ဂုဏ်ယူပါသည်။ သင်သည် %(title)s ကို အောင်မြင်ပြီး ၎င်း၏လက်မှတ်ကို "
"ရရှိခဲ့ပါသည်။"

msgid "You got this email because of your notification settings."
msgstr "သင့်အသိပေးချက် ဆက်တင်များကြောင့် ဤအီးမေးလ်ကို သင်ရရှိခြင်း ဖြစ်ပါသည်။"

msgid "A learner"
msgstr "သင်ယူသူတစ်ဦး"

msgid "%(who)s completed %(title)s on a seat from %(tenant)s."
msgstr "%(who)s သည် %(tenant)s မှ နေရာဖြင့် %(title)s ကို ပြီးဆုံးခဲ့သည်။"

msgid "%(who)s passed %(title)s on a seat from %(tenant)s."
msgstr "%(who)s သည် %(tenant)s မှ နေရာဖြင့် %(title)s ကို အောင်မြင်ခဲ့သည်။"

#. Translators: %(who)s is a learner's name; %(title)s a course or program.
msgid "%(who)s finished %(title)s"
msgstr "%(who)s သည် %(title)s ကို ပြီးဆုံးခဲ့သည်"

msgid "%(email)s hasn't accepted your invitation"
msgstr "%(email)s သည် သင့်ဖိတ်ကြားချက်ကို လက်မခံရသေးပါ"

#. Translators: %(day)s is the date the invitation was sent.
msgid ""
"You invited %(email)s to learn with %(tenant)s on %(day)s, and they haven't "
"accepted yet. You can send the invitation again from People."
msgstr ""
"%(day)s တွင် %(tenant)s နှင့်အတူ သင်ယူရန် %(email)s ကို "
"သင်ဖိတ်ကြားခဲ့သော်လည်း ၎င်းတို့ လက်မခံရသေးပါ။ လူများ မှ ဖိတ်ကြားချက်ကို "
"ထပ်ပို့နိုင်ပါသည်။"

msgid "a course"
msgstr "သင်တန်းတစ်ခု"

#. Translators: %(seats)s is a number of seats ("3 seats"); %(where)s what
#. they are for.
msgid "%(seats)s in %(where)s not given out yet"
msgstr "%(where)s တွင် မပေးအပ်ရသေးသော %(seats)s"

msgid ""
"%(tenant)s still has %(seats)s to give out in %(where)s. Enrollment closes "
"on %(day)s; seats not given by then can't be used."
msgstr ""
"%(tenant)s တွင် %(where)s ၌ ပေးအပ်ရန် %(seats)s ကျန်ရှိနေပါသေးသည်။ "
"စာရင်းသွင်းခြင်းကို %(day)s တွင် ပိတ်မည်ဖြစ်ပြီး ထိုအချိန်အထိ မပေးအပ်ရသေးသော"
" နေရာများကို အသုံးပြု၍မရတော့ပါ။"

msgid "Order %(number)s is paid"
msgstr "မှာယူမှု %(number)s ကို ပေးချေပြီးပါပြီ"

#. Translators: %(total)s is money with its currency; %(tenant)s a company.
msgid ""
"We received %(total)s for %(tenant)s's order %(number)s. Its seats are ready"
" to give out."
msgstr ""
"%(tenant)s ၏ မှာယူမှု %(number)s အတွက် %(total)s ကို လက်ခံရရှိပါသည်။ ၎င်း၏ "
"နေရာများကို ပေးအပ်ရန် အသင့်ဖြစ်ပါပြီ။"

msgid "Privacy policy"
msgstr "ကိုယ်ရေးအချက်အလက် မူဝါဒ"

msgid "Terms of use"
msgstr "အသုံးပြုမှု စည်းမျဉ်းများ"

msgid "%(tenant)s is ready"
msgstr "%(tenant)s အသင့်ဖြစ်ပါပြီ"

#. Translators: %(limit)s is a number of people.
msgid ""
"Your account is active. You can have up to %(limit)s people learning at "
"once."
msgstr ""
"သင့်အကောင့် အသက်ဝင်နေပါပြီ။ တစ်ပြိုင်နက် လူ %(limit)s ဦးအထိ သင်ယူနိုင်ပါသည်။"

#. Translators: %(tenant)s is a company's name; %(limit)s is a number of
#. people.
msgid ""
"%(tenant)s's contract was renewed with a learner limit of %(limit)s. Choose "
"who keeps access."
msgstr ""
"%(tenant)s ၏ စာချုပ်ကို သင်ယူသူ ကန့်သတ်ချက် %(limit)s ဖြင့် "
"သက်တမ်းတိုးထားပါသည်။ ဝင်ရောက်ခွင့် ဆက်ရှိမည့်သူများကို ရွေးချယ်ပါ။"

#. Translators: %(tenant)s is a company's name.
msgid "%(tenant)s is on hold for payment"
msgstr "%(tenant)s ကို ငွေပေးချေမှုအတွက် ဆိုင်းငံ့ထားသည်"

msgid ""
"Learning your company pays for is paused until this is cleared. Progress and"
" certificates are kept."
msgstr ""
"ဤကိစ္စ မရှင်းမချင်း သင့်ကုမ္ပဏီက ပေးချေသော သင်ယူမှုကို ခေတ္တရပ်ထားပါသည်။ "
"တိုးတက်မှုနှင့် လက်မှတ်များကို ဆက်ထားပါသည်။"

#. Translators: %(tenant)s is a company's name.
msgid "%(tenant)s is no longer on hold"
msgstr "%(tenant)s သည် ဆိုင်းငံ့ထားခြင်း မရှိတော့ပါ"

msgid ""
"The payment hold has ended. Your people can carry on with their learning."
msgstr ""
"ငွေပေးချေမှု ဆိုင်းငံ့ခြင်း ပြီးဆုံးပါပြီ။ သင့်လူများ ၎င်းတို့၏ သင်ယူမှုကို "
"ဆက်လုပ်နိုင်ပါပြီ။"

#. Translators: %(tenant)s is a company's name.
msgid "%(tenant)s is blocked"
msgstr "%(tenant)s ကို ပိတ်ဆို့ထားသည်"

msgid ""
"Nobody can use your company's account or the learning it pays for until it "
"is unblocked."
msgstr ""
"ပိတ်ဆို့မှု မဖြုတ်မချင်း သင့်ကုမ္ပဏီ၏ အကောင့် သို့မဟုတ် ၎င်းက ပေးချေသော "
"သင်ယူမှုကို မည်သူမျှ အသုံးမပြုနိုင်ပါ။"

#. Translators: %(tenant)s is a company's name.
msgid "%(tenant)s is unblocked"
msgstr "%(tenant)s ကို ပိတ်ဆို့မှု ဖြုတ်ပြီးပါပြီ"

msgid "You and your people can sign in and carry on."
msgstr "သင်နှင့် သင့်လူများ အကောင့်ဝင်ပြီး ဆက်လုပ်နိုင်ပါပြီ။"

#. Translators: %(tenant)s is a company's name.
msgid "%(tenant)s asks to renew"
msgstr "%(tenant)s က သက်တမ်းတိုးရန် တောင်းဆိုသည်"

#. Translators: %(who)s is a person's name, %(tenant)s the company they manage
#. and %(note)s their own
#. message.
msgid ""
"%(who)s, who manages %(tenant)s, asked to renew the company's contract. "
"“%(note)s”"
msgstr ""
"%(tenant)s ကို စီမံသူ %(who)s က ကုမ္ပဏီ၏ စာချုပ်ကို သက်တမ်းတိုးရန် "
"တောင်းဆိုခဲ့ပါသည်။ “%(note)s”"

#. Translators: %(who)s is a person's name; %(tenant)s is the company they
#. manage.
msgid ""
"%(who)s, who manages %(tenant)s, asked to renew the company's contract."
msgstr ""
"%(tenant)s ကို စီမံသူ %(who)s က ကုမ္ပဏီ၏ စာချုပ်ကို သက်တမ်းတိုးရန် "
"တောင်းဆိုခဲ့ပါသည်။"

#. Translators: %(seats)s lists the seats, such as "20 seats in Fire safety
#. and 5 seats in First aid".
msgid "Your %(seats)s is ready to give out."
msgid_plural "Your %(seats)s are ready to give out."
msgstr[0] "သင့် %(seats)s ကို ပေးအပ်ရန် အသင့်ဖြစ်ပါပြီ။"

msgid "An invoice is overdue."
msgstr "ငွေတောင်းခံလွှာ သတ်မှတ်ရက် ကျော်လွန်နေပါသည်။"

msgid "The overdue invoice is settled."
msgstr "သတ်မှတ်ရက် ကျော်လွန်နေသော ငွေတောင်းခံလွှာကို ပေးချေပြီးပါပြီ။"

msgid "The reason given:"
msgstr "ပေးထားသော အကြောင်းပြချက်:"

msgid "Grades"
msgstr "အမှတ်အဆင့်များ"

msgid "Enrollments"
msgstr "စာရင်းသွင်းမှုများ"

msgid "Certificates"
msgstr "လက်မှတ်များ"

msgid "Session attendance"
msgstr "စာသင်ချိန် တက်ရောက်မှု"

msgid "Learner progress"
msgstr "သင်ယူသူ တိုးတက်မှု"

msgid "Every answer"
msgstr "အဖြေတိုင်း"

msgid "Submissions"
msgstr "တင်သွင်းမှုများ"

msgid "Anonymous IDs"
msgstr "အမည်မဖော် ID များ"

msgid "Video views"
msgstr "ဗီဒီယို ကြည့်ရှုမှုများ"

msgid "Assessment scores"
msgstr "အကဲဖြတ်ချက် အမှတ်များ"

msgid "Invited, not enrolled"
msgstr "ဖိတ်ကြားထားပြီး စာရင်းမသွင်းရသေး"

#. Translators: {report} is the report's name.
msgid "Your {report} report is ready"
msgstr "သင့် {report} အစီရင်ခံစာ အသင့်ဖြစ်ပါပြီ"

#. Translators: {report} is the report's name.
msgid "The {report} report for this course is ready to download."
msgstr ""
"ဤသင်တန်းအတွက် {report} အစီရင်ခံစာကို ဒေါင်းလုဒ်လုပ်ရန် အသင့်ဖြစ်ပါပြီ။"

msgid "Download the report"
msgstr "အစီရင်ခံစာကို ဒေါင်းလုဒ်လုပ်ရန်"

msgid "Your data is ready to download"
msgstr "သင့်ဒေတာ ဒေါင်းလုဒ်လုပ်ရန် အသင့်ဖြစ်ပါပြီ"

#. Translators: {days} is how many days the download link works.
msgid ""
"Your data is ready: one zip file of everything Blend-ed keeps. The link "
"works for {days} days, and only for you."
msgstr ""
"သင့်ဒေတာ အသင့်ဖြစ်ပါပြီ- Blend-ed သိမ်းဆည်းထားသမျှ အားလုံးပါဝင်သော zip "
"ဖိုင်တစ်ခု ဖြစ်ပါသည်။ လင့်ခ်သည် {days} ရက် အလုပ်လုပ်ပြီး သင့်အတွက်သာ "
"ဖြစ်ပါသည်။"

#. Translators: the title when the person whose data was exported no longer
#. has an account.
msgid "this person's data is ready to download"
msgstr "ဤပုဂ္ဂိုလ်၏ ဒေတာကို ဒေါင်းလုဒ်လုပ်ရန် အသင့်ဖြစ်ပါပြီ"

#. Translators: the message when the person whose data was exported no longer
#. has an account; {days} is
#. how many days the link works.
msgid ""
"this person's data is ready: one zip file of everything Blend-ed keeps. The "
"link works for {days} days, and only for you."
msgstr ""
"ဤပုဂ္ဂိုလ်၏ ဒေတာ အသင့်ဖြစ်ပါပြီ- Blend-ed သိမ်းဆည်းထားသမျှ အားလုံးပါဝင်သော "
"zip ဖိုင်တစ်ခု ဖြစ်ပါသည်။ လင့်ခ်သည် {days} ရက် အလုပ်လုပ်ပြီး သင့်အတွက်သာ "
"ဖြစ်ပါသည်။"

#. Translators: {name} is the person whose data was exported.
msgid "{name}'s data is ready to download"
msgstr "{name} ၏ ဒေတာ ဒေါင်းလုဒ်လုပ်ရန် အသင့်ဖြစ်ပါပြီ"

#. Translators: {name} is the person whose data was exported; {days} how many
#. days the link works.
msgid ""
"{name}'s data is ready: one zip file of everything Blend-ed keeps. The link "
"works for {days} days, and only for you."
msgstr ""
"{name} ၏ ဒေတာ အသင့်ဖြစ်ပါပြီ- Blend-ed သိမ်းဆည်းထားသမျှ အားလုံးပါဝင်သော zip "
"ဖိုင်တစ်ခု ဖြစ်ပါသည်။ လင့်ခ်သည် {days} ရက် အလုပ်လုပ်ပြီး သင့်အတွက်သာ "
"ဖြစ်ပါသည်။"

msgid "Download the file"
msgstr "ဖိုင်ကို ဒေါင်းလုဒ်လုပ်ရန်"

msgid "Your full export is ready to download"
msgstr "သင့်အပြည့်အစုံ ထုတ်ယူမှု ဒေါင်းလုဒ်လုပ်ရန် အသင့်ဖြစ်ပါပြီ"

#. Translators: {days} is how many days the download link works.
msgid ""
"Your full export is ready: one zip file of your platform's records. The link"
" works for {days} days, and only for you."
msgstr ""
"သင့်အပြည့်အစုံ ထုတ်ယူမှု အသင့်ဖြစ်ပါပြီ- သင့်ပလက်ဖောင်း၏ "
"မှတ်တမ်းများပါဝင်သော zip ဖိုင်တစ်ခု ဖြစ်ပါသည်။ လင့်ခ်သည် {days} ရက် "
"အလုပ်လုပ်ပြီး သင့်အတွက်သာ ဖြစ်ပါသည်။"

#. Translators: {report} is the report's name; {start} and {end} are dates
#. (YYYY-MM-DD),
#. {end} followed by the period's time zone ("2026-11-23 UTC").
msgid "The {report} report for {start} to {end} is ready to download."
msgstr ""
"{start} မှ {end} အထိ {report} အစီရင်ခံစာကို ဒေါင်းလုဒ်လုပ်ရန် "
"အသင့်ဖြစ်ပါပြီ။"

#. Translators: {month} is the month just ended with its time zone ("October
#. 2026 UTC"); the others are
#. counts.
msgid ""
"{month}. Seats in use: {assigned} of {funded}. New seats: {new_seats}. "
"Results recorded: {results}. Certificates earned: {certificates}."
msgstr ""
"{month}။ အသုံးပြုနေသော နေရာများ: {funded} အနက် {assigned}။ နေရာအသစ်များ: "
"{new_seats}။ မှတ်တမ်းတင်ထားသော ရလဒ်များ: {results}။ ရရှိခဲ့သော လက်မှတ်များ: "
"{certificates}။"

#. Translators: {end} is the week's last day, a Sunday, with its time zone
#. ("22 November 2026 UTC"); the others
#. are counts.
msgid ""
"Week to {end}. Seats in use: {assigned} of {funded}. New seats: {new_seats}."
" Results recorded: {results}. Certificates earned: {certificates}."
msgstr ""
"{end} အထိ အပတ်။ အသုံးပြုနေသော နေရာများ- {funded} ခုအနက် {assigned} ခု။ "
"နေရာအသစ်များ- {new_seats}။ မှတ်တမ်းတင်ထားသော ရလဒ်များ- {results}။ ရရှိသော "
"လက်မှတ်များ- {certificates}။"

#. Translators: {tenant} is the company's name.
msgid "{tenant}: your month in learning"
msgstr "{tenant}: သင်ယူမှုဆိုင်ရာ သင့်လ"

#. Translators: {tenant} is the company's name.
msgid "{tenant}: your week in learning"
msgstr "{tenant}- သင်ယူမှုတွင် သင့်အပတ်"

#. Translators: {name} is the instructor's name; {title} is the session's
#. name.
msgid "{name} is away for {title}"
msgstr "{name} သည် {title} အတွက် မရှိပါ"

#. Translators: {title} is the session's name, {when} the date's start and
#. {name} the instructor's name.
msgid ""
"{title} on {when} falls in {name}'s time off. They are still its instructor "
"until you change it."
msgstr ""
"{when} ရှိ {title} သည် {name} ၏ အားလပ်ချိန်အတွင်း ကျရောက်နေပါသည်။ "
"သင်ပြောင်းလဲသည်အထိ ၎င်းတို့သည် ၎င်း၏ နည်းပြအဖြစ် ဆက်ရှိနေပါမည်။"

#. Translators: {title} is the session's name; the instructor's name is not
#. known.
msgid "An instructor is away for {title}"
msgstr "{title} အတွက် နည်းပြတစ်ဦး မရှိပါ"

#. Translators: {title} is the session's name and {when} the date's start; the
#. instructor's name is not
#. known.
msgid ""
"{title} on {when} falls in the instructor's time off. They are still its "
"instructor until you change it."
msgstr ""
"{when} ရှိ {title} သည် နည်းပြ၏ အားလပ်ချိန်အတွင်း ကျရောက်နေပါသည်။ "
"သင်ပြောင်းလဲသည်အထိ ၎င်းတို့သည် ၎င်း၏နည်းပြအဖြစ် ဆက်ရှိနေပါမည်။"

msgid "{name}, you earned a Session certificate!"
msgstr "{name}၊ သင် စာသင်ချိန် လက်မှတ်တစ်ခု ရရှိပါပြီ!"

#. Translators: {part} is the date's number within the session; {title} is the
#. session's name.
msgid "Part {part} of {title}"
msgstr "{title} ၏ အပိုင်း {part}"

#. Translators: {by} is who moved the date; {title} the date's name; {when}
#. the new date and time, {was}
#. the old one.
msgid "{by} moved {title} to {when} (it was {was})."
msgstr "{by} က {title} ကို {when} သို့ ရွှေ့ခဲ့သည် (ယခင် {was})။"

#. Translators: the whole message when no one is named; English leaves out who
#. did it. Write it as a
#. complete sentence ("{title} was moved to …"). {when} is the new date and
#. time, {was} the old one.
msgid "moved {title} to {when} (it was {was})."
msgstr "က {title} ကို {when} သို့ ရွှေ့ခဲ့သည် (ယခင် {was})။"

msgid "{title} moved"
msgstr "{title} ရွှေ့ပြီး"

#. Translators: {by} is who cancelled the date; {title} the date's name; {was}
#. the date and time it had.
msgid "{by} cancelled {title}, {was}."
msgstr "{by} က {title}၊ {was} ကို ပယ်ဖျက်ခဲ့သည်။"

#. Translators: the whole message when no one is named; English leaves out who
#. did it. Write it as a
#. complete sentence ("{title}, {was}, was cancelled."). {was} is the date and
#. time it had.
msgid "cancelled {title}, {was}."
msgstr "က {title}၊ {was} ကို ပယ်ဖျက်ခဲ့သည်။"

msgid "{title} cancelled"
msgstr "{title} ပယ်ဖျက်ပြီး"

#. Translators: {by} is who added the instructor; {title} the date's name;
#. {when} its date and time.
msgid "{by} added you to {title}, {when}."
msgstr "{by} က သင့်ကို {title}၊ {when} သို့ ထည့်သွင်းခဲ့သည်။"

#. Translators: the whole message when no one is named; English leaves out who
#. did it. Write it as a
#. complete sentence ("You were added to {title}, {when}."). {when} is the
#. date and time.
msgid "added you to {title}, {when}."
msgstr "က သင့်ကို {title}၊ {when} သို့ ထည့်သွင်းခဲ့သည်။"

msgid "You're teaching {title}"
msgstr "သင်သည် {title} ကို သင်ကြားမည် ဖြစ်ပါသည်"

#. Translators: {by} is who changed the date's instructors; {title} the date's
#. name; {was} its date and time.
msgid "{by} changed its instructors; {title} on {was} is not yours any more."
msgstr ""
"{by} က ၎င်း၏ နည်းပြများကို ပြောင်းလဲခဲ့သည်။ {was} ရှိ {title} သည် သင့်တာဝန် "
"မဟုတ်တော့ပါ။"

#. Translators: the whole message when no one is named; English leaves out who
#. did it. Write it as a complete
#. sentence ("Its instructors changed; …"). {was} is the date and time.
msgid "changed its instructors; {title} on {was} is not yours any more."
msgstr ""
"က ၎င်း၏ နည်းပြများကို ပြောင်းလဲခဲ့သည်။ {was} ရှိ {title} သည် သင့်တာဝန် "
"မဟုတ်တော့ပါ။"

msgid "You're no longer teaching {title}"
msgstr "သင်သည် {title} ကို သင်ကြားခြင်း မရှိတော့ပါ"

msgid "Confirm attendance for {title}"
msgstr "{title} အတွက် တက်ရောက်မှုကို အတည်ပြုပါ"

msgid "{title} has ended. Confirm who attended."
msgstr "{title} ပြီးဆုံးသွားပါပြီ။ တက်ရောက်သူများကို အတည်ပြုပါ။"

#. Translators: {title} is the session's name; {minutes} how many minutes
#. until it starts. English keeps
#. "minutes" even for 1.
msgid "{title} starts in {minutes} minutes"
msgid_plural "{title} starts in {minutes} minutes"
msgstr[0] "{title} သည် {minutes} မိနစ်အတွင်း စတင်ပါမည်"

#. Translators: {title} is the session's name; {when} its start date and time.
msgid "{title} starts at {when}."
msgstr "{title} သည် {when} တွင် စတင်ပါမည်။"

msgid "Tomorrow: {count} session"
msgid_plural "Tomorrow: {count} sessions"
msgstr[0] "မနက်ဖြန်- စာသင်ချိန် {count} ခု"

msgid "{count} new submission to review"
msgid_plural "{count} new submissions to review"
msgstr[0] "စစ်ဆေးရန် တင်သွင်းမှုအသစ် {count} ခု"

#. Translators: {batch} is the batch's name; {count} how many submissions wait
#. for a grade.
msgid "{batch}: {count} submission waiting for a grade."
msgid_plural "{batch}: {count} submissions waiting for a grade."
msgstr[0] "{batch}- အမှတ်ပေးရန် စောင့်နေသော တင်သွင်းမှု {count} ခု။"

msgid "Weekly review due for {batches}"
msgstr "{batches} အတွက် အပတ်စဉ် ပြန်လည်သုံးသပ်ရန် အချိန်ရောက်ပါပြီ"

msgid "below the passing score"
msgstr "အောင်မှတ်အောက် ရောက်နေသည်"

msgid "not active for 14 days"
msgstr "၁၄ ရက်ကြာ မလှုပ်ရှားပါ"

msgid "not active for 7 days"
msgstr "၇ ရက်ကြာ မလှုပ်ရှားပါ"

msgid "behind on progress"
msgstr "တိုးတက်မှု နောက်ကျနေသည်"

msgid "has not started"
msgstr "မစတင်ရသေးပါ"

msgid "failed an assessment"
msgstr "အကဲဖြတ်ချက်တွင် ကျရှုံးခဲ့သည်"

msgid "behind schedule"
msgstr "အချိန်ဇယားထက် နောက်ကျနေသည်"

msgid "{name} needs help"
msgstr "{name} အကူအညီ လိုအပ်နေပါသည်"

#. Translators: {name} is the learner's name, {batch} the batch's and {why}
#. the reasons,
#. comma-separated.
msgid "{name} in {batch}: {why}."
msgstr "{batch} ရှိ {name}- {why}။"

msgid "{title}: your date has moved"
msgstr "{title}- သင့်ရက်စွဲ ရွှေ့သွားပါပြီ"

msgid "Your date of {title} now starts at {when}."
msgstr "{title} ၏ သင့်ရက်စွဲသည် ယခု {when} တွင် စတင်ပါမည်။"

msgid "{title}: your date is cancelled"
msgstr "{title}- သင့်ရက်စွဲကို ပယ်ဖျက်လိုက်ပါပြီ"

msgid ""
"The date of {title} you had a place on is cancelled. You can book another "
"date."
msgstr ""
"သင်နေရာရရှိထားသော {title} ၏ ရက်စွဲကို ပယ်ဖျက်လိုက်ပါသည်။ အခြားရက်စွဲတစ်ခုကို"
" ကြိုတင်စာရင်းသွင်းနိုင်ပါသည်။"

msgid "{title}: you have a place"
msgstr "{title}- သင့်နေရာ ရရှိပါပြီ"

msgid "A place freed on {title} and you are booked for {when}."
msgstr ""
"{title} တွင် နေရာတစ်ခု လွတ်သွားပြီး သင့်ကို {when} အတွက် "
"ကြိုတင်စာရင်းသွင်းပေးထားပါသည်။"

#. Translators: {title} is the session's name; {count} how many hours until it
#. starts.
msgid "{title} starts in {count} hour"
msgid_plural "{title} starts in {count} hours"
msgstr[0] "{title} သည် {count} နာရီအတွင်း စတင်ပါမည်"

#. Translators: {title} is the session's name.
msgid "{title} starts in 1 hour"
msgstr "{title} သည် 1 နာရီအတွင်း စတင်ပါမည်"

#. Translators: {title} is the session's name.
msgid "{title} starts in a few minutes"
msgstr "{title} သည် မိနစ်အနည်းငယ်အတွင်း စတင်ပါမည်"

#. Translators: {title} is the session's name; {count} how many minutes until
#. it starts (5 or more).
msgid "{title} starts in {count} minute"
msgid_plural "{title} starts in {count} minutes"
msgstr[0] "{title} သည် {count} မိနစ်အတွင်း စတင်ပါမည်"

#. Translators: {title} is the session's name; {when} is its start date and
#. time.
msgid "Your booked date of {title} starts at {when}."
msgstr ""
"{title} တွင် သင်ကြိုတင်စာရင်းသွင်းထားသော ရက်စွဲသည် {when} တွင် စတင်ပါမည်။"

#. Translators: {name} is who raised it, {type} the ticket's type code (issue,
#. bug, feature, other) and {title}
#. its title.
msgid "{name} raised a new {type} ticket: {title}"
msgstr "{name} က {type} တီကတ်အသစ် တင်သွင်းခဲ့သည်- {title}"

msgid "New support ticket"
msgstr "အကူအညီ တီကတ်အသစ်"

msgid "Your support update"
msgstr "သင့်အကူအညီ အပ်ဒိတ်"

msgid "Your ticket {title} has been closed."
msgstr "သင့်တီကတ် {title} ကို ပိတ်လိုက်ပါပြီ။"

msgid "Your ticket {title} has been reopened."
msgstr "သင့်တီကတ် {title} ကို ပြန်ဖွင့်လိုက်ပါပြီ။"

msgid "Ticket assigned to you"
msgstr "သင့်ထံ တာဝန်ပေးအပ်ထားသော တီကတ်"

msgid "You have been assigned the ticket {title}."
msgstr "တီကတ် {title} ကို သင့်ထံ တာဝန်ပေးအပ်ထားပါသည်။"

#. Translators: {name} is who commented, {title} the ticket's title and
#. {comment} their words.
msgid "{name} commented on your ticket {title}: {comment}"
msgstr "{name} က သင့်တီကတ် {title} တွင် မှတ်ချက်ပေးခဲ့သည်- {comment}"

msgid "New comment on your ticket"
msgstr "သင့်တီကတ်တွင် မှတ်ချက်အသစ်"
