msgid "I completed the {course_title} course on {course_org_name}."
msgstr ""
"ကျွန်ုပ်သည် {course_org_name} တွင် {course_title} သင်တန်းကို "
"ပြီးဆုံးခဲ့ပါသည်။"

msgid ""
"I completed a course at {course_org_name}. Take a look at my certificate."
msgstr ""
"ကျွန်ုပ်သည် {course_org_name} တွင် သင်တန်းတစ်ခု ပြီးဆုံးခဲ့ပါသည်။ ကျွန်ုပ်၏ "
"လက်မှတ်ကို ကြည့်ပါ။"

msgid "%(fullname)s, you earned a certificate!"
msgstr "%(fullname)s၊ သင် လက်မှတ်တစ်ခု ရရှိပါပြီ!"

msgid "Awarded to:"
msgstr "ချီးမြှင့်သူ-"

msgid "Recipient Image"
msgstr "လက်ခံသူ၏ ပုံ"

msgid "Validity"
msgstr "သက်တမ်း"

msgid "Does not expire"
msgstr "သက်တမ်း မကုန်ပါ"

msgid "Share on"
msgstr "မျှဝေရန်"

msgid "Post on Facebook"
msgstr "Facebook တွင် တင်ရန်"

msgid "Tweet this Accomplishment"
msgstr "ဤအောင်မြင်မှုကို Tweet လုပ်ရန်"

msgid "Add to LinkedIn Profile"
msgstr "LinkedIn ပရိုဖိုင်သို့ ထည့်ရန်"

msgid "Download PDF"
msgstr "PDF ဒေါင်းလုဒ်လုပ်ရန်"

msgid "This is to certify that"
msgstr "ဤသည်မှာ အောက်ပါပုဂ္ဂိုလ်သည်"

#. Translators: follows the learner's name, which the certificate shows on its
#. own line above; the sentence's subject is that name.
msgid "has successfully completed %(course_name)s offered by %(org_name)s"
msgstr ""
"%(org_name)s က ပို့ချသော %(course_name)s ကို အောင်မြင်စွာ ပြီးဆုံးခဲ့ပါသည်"

msgid "Date of Issue: %(date)s"
msgstr "ထုတ်ပေးသည့်ရက်- %(date)s"

msgid "Programme"
msgstr "ပရိုဂရမ်"

msgid "Verified"
msgstr "အတည်ပြုပြီး"

#. Translators: follows the learner's name, which the certificate shows on its
#. own line above; the sentence's subject is that name.
msgid ""
"has successfully completed and was awarded this certificate for the "
"programme above."
msgstr ""
"အထက်ပါ ပရိုဂရမ်ကို အောင်မြင်စွာ ပြီးဆုံးခဲ့ပြီး ဤလက်မှတ်ကို "
"ချီးမြှင့်ခံရပါသည်။"

msgid ""
"has successfully completed, received a passing grade, and was awarded this "
"certificate for the course above."
msgstr ""
"အထက်ပါ သင်တန်းကို အောင်မြင်စွာ ပြီးဆုံးခဲ့ပြီး အောင်မှတ်ရရှိကာ ဤလက်မှတ်ကို "
"ချီးမြှင့်ခံရပါသည်။"

msgid "Issued on %(date)s"
msgstr "ထုတ်ပေးသည့်ရက် %(date)s"

msgid "Valid until %(date)s"
msgstr "%(date)s အထိ သက်တမ်းရှိသည်"

msgid "Sincerely,"
msgstr "လေးစားစွာဖြင့်၊"

msgid "Supported by the following organizations"
msgstr "အောက်ပါ အဖွဲ့အစည်းများက ပံ့ပိုးထားသည်"

msgid "Certificate of Attendance"
msgstr "တက်ရောက်မှု လက်မှတ်"

msgid "Noted by"
msgstr "မှတ်သားသူ"

msgid "This certificate has been revoked"
msgstr "ဤလက်မှတ်ကို ရုပ်သိမ်းထားသည်"

msgid ""
"The certificate for %(program)s was revoked on %(date)s. It is no longer "
"valid."
msgstr ""
"%(program)s အတွက် လက်မှတ်ကို %(date)s တွင် ရုပ်သိမ်းခဲ့သည်။ ၎င်းသည် "
"အကျုံးမဝင်တော့ပါ။"

#. Translators: follows the learner's name, which the certificate shows on its
#. own line above; the sentence's subject is that name.
msgid ""
"has successfully completed the programme %(program)s offered by %(org)s"
msgstr ""
"%(org)s က ပို့ချသော %(program)s ပရိုဂရမ်ကို အောင်မြင်စွာ ပြီးဆုံးခဲ့ပါသည်"

msgid "Completed on %(date)s"
msgstr "%(date)s တွင် ပြီးဆုံးခဲ့သည်"

msgid "Courses:"
msgstr "သင်တန်းများ-"

msgid "Verify this certificate at %(url)s"
msgstr "ဤလက်မှတ်ကို %(url)s တွင် အတည်ပြုပါ"

msgid "Certificate not found"
msgstr "လက်မှတ် ရှာမတွေ့ပါ"

msgid "There is no valid certificate at this link."
msgstr "ဤလင့်ခ်တွင် မှန်ကန်သော လက်မှတ် မရှိပါ။"

msgid "Certificate of competency"
msgstr "ကျွမ်းကျင်မှု လက်မှတ်"

msgid "Holder name"
msgstr "ကိုင်ဆောင်သူအမည်"

msgid "Competency"
msgstr "ကျွမ်းကျင်မှု"

msgid "Knowledge"
msgstr "အသိပညာ"

msgid "Role"
msgstr "အခန်းကဏ္ဍ"

msgid "Field"
msgstr "အကွက်"

msgid "Course"
msgstr "သင်တန်း"

msgid "Basis of training"
msgstr "သင်တန်း၏ အခြေခံ"

msgid "Title"
msgstr "ခေါင်းစဉ်"

msgid "Eligibility requirements"
msgstr "အရည်အချင်း လိုအပ်ချက်များ"

msgid "Formal education"
msgstr "တရားဝင် ပညာရေး"

msgid "Professional experience"
msgstr "လုပ်ငန်း အတွေ့အကြုံ"

msgid "Results"
msgstr "ရလဒ်များ"

msgid "Certificate number"
msgstr "လက်မှတ်နံပါတ်"

msgid "Initial certification"
msgstr "ကနဦး အသိအမှတ်ပြုလက်မှတ်ထုတ်ပေးခြင်း"

msgid "This certificate"
msgstr "ဤလက်မှတ်"

msgid "Expiry Date"
msgstr "သက်တမ်းကုန်ဆုံးရက်"

msgid "Knowledge certificates do not expire"
msgstr "အသိပညာ လက်မှတ်များ သက်တမ်းမကုန်ပါ"

msgid ""
"The certificate for %(session)s was revoked on %(date)s. It is no longer "
"valid."
msgstr ""
"%(session)s အတွက် လက်မှတ်ကို %(date)s တွင် ရုပ်သိမ်းခဲ့သည်။ ၎င်းသည် "
"အကျုံးမဝင်တော့ပါ။"

msgid "This certificate expired on %(date)s."
msgstr "ဤလက်မှတ်သည် %(date)s တွင် သက်တမ်းကုန်ခဲ့သည်။"

#. Translators: follows the learner's name, which the certificate shows on its
#. own line above; the sentence's subject is that name.
msgid "has successfully attended %(session)s offered by %(org)s"
msgstr "%(org)s က ပို့ချသော %(session)s ကို အောင်မြင်စွာ တက်ရောက်ခဲ့ပါသည်"

#. Translators: follows the learner's name, written large on the line above.
#. %(course_name)s is the course's name; keep the <span> around it (bold) and
#. the three <div>s (each is one line on the certificate).
msgid ""
"<div>has successfully completed the</div>\n"
"                    <div><span style=\"font-weight:600;\">%(course_name)s</span> course</div>\n"
"                    <div>at ACSF Level 3.</div>"
msgstr ""
"<div>သည်</div>\n"
"                    <div><span style=\"font-weight:600;\">%(course_name)s</span> သင်တန်းကို</div>\n"
"                    <div>ACSF အဆင့် 3 ဖြင့် အောင်မြင်စွာ ပြီးဆုံးခဲ့ပါသည်။</div>"

#. Translators: %(when)s is a date and time with its time zone, such as "17
#. November 2026, 09:30 IST".
msgid ""
"The password for your account was changed on %(when)s. If this wasn't you, "
"reset your password now and contact support."
msgstr ""
"သင့်အကောင့်၏ စကားဝှက်ကို %(when)s တွင် ပြောင်းလဲခဲ့သည်။ ဤသည်မှာ သင် မဟုတ်ပါက"
" သင့်စကားဝှက်ကို ယခုပင် ပြန်လည်သတ်မှတ်ပြီး ပံ့ပိုးမှုအဖွဲ့ကို ဆက်သွယ်ပါ။"

msgid "Your password was changed"
msgstr "သင့်စကားဝှက်ကို ပြောင်းလဲခဲ့ပါသည်"

msgid "Password changed"
msgstr "စကားဝှက် ပြောင်းလဲပြီး"

msgid ""
"Confirms to the user that their account password was changed. Security "
"notice — cannot be disabled."
msgstr ""
"အသုံးပြုသူ၏ အကောင့်စကားဝှက် ပြောင်းလဲပြီးကြောင်း အတည်ပြုပေးပါသည်။ လုံခြုံရေး"
" အသိပေးချက် — ပိတ်၍မရပါ။"

msgid "Invitation — new user"
msgstr "ဖိတ်ကြားချက် — အသုံးပြုသူအသစ်"

msgid "Invites an unregistered user to the platform."
msgstr "စာရင်းမသွင်းရသေးသော အသုံးပြုသူကို ပလက်ဖောင်းသို့ ဖိတ်ကြားပါသည်။"

msgid "Added to organization"
msgstr "အဖွဲ့အစည်းသို့ ထည့်သွင်းပြီး"

msgid "Sent when an existing platform user is added to the organization."
msgstr ""
"ရှိပြီးသား ပလက်ဖောင်းအသုံးပြုသူကို အဖွဲ့အစည်းသို့ ထည့်သွင်းသည့်အခါ "
"ပို့ပါသည်။"

msgid "Organization + account created"
msgstr "အဖွဲ့အစည်း + အကောင့် ဖန်တီးပြီး"

msgid ""
"Sent when an organization and its first account are created via the public "
"API."
msgstr ""
"အဖွဲ့အစည်းတစ်ခုနှင့် ၎င်း၏ ပထမဆုံးအကောင့်ကို အများသုံး API မှတစ်ဆင့် "
"ဖန်တီးသည့်အခါ ပို့ပါသည်။"

msgid "Course enrollment — new user"
msgstr "သင်တန်း စာရင်းသွင်းခြင်း — အသုံးပြုသူအသစ်"

msgid ""
"Sent when an unregistered user is enrolled in a course and must register "
"first."
msgstr ""
"စာရင်းမသွင်းရသေးသော အသုံးပြုသူကို သင်တန်းတွင် စာရင်းသွင်းပြီး ဦးစွာ "
"မှတ်ပုံတင်ရမည့်အခါ ပို့ပါသည်။"

msgid "Course enrollment — success"
msgstr "သင်တန်း စာရင်းသွင်းခြင်း — အောင်မြင်သည်"

msgid "Sent when a learner is enrolled in a course."
msgstr "သင်ယူသူတစ်ဦးကို သင်တန်းတွင် စာရင်းသွင်းသည့်အခါ ပို့ပါသည်။"

msgid "Course enrollment — update"
msgstr "သင်တန်း စာရင်းသွင်းခြင်း — အပ်ဒိတ်"

msgid "Sent when a learner's enrollment changes."
msgstr "သင်ယူသူ၏ စာရင်းသွင်းမှု ပြောင်းလဲသည့်အခါ ပို့ပါသည်။"

msgid "Program enrollment — success"
msgstr "ပရိုဂရမ် စာရင်းသွင်းခြင်း — အောင်မြင်သည်"

msgid "Sent when a learner is enrolled in a program."
msgstr "သင်ယူသူတစ်ဦးကို ပရိုဂရမ်တွင် စာရင်းသွင်းသည့်အခါ ပို့ပါသည်။"

msgid "Learner self-enrolled"
msgstr "သင်ယူသူ ကိုယ်တိုင်စာရင်းသွင်းခဲ့သည်"

msgid ""
"Tells the course team that a learner enrolled themselves in their course. "
"Enrollments performed by staff are not announced — whoever ran them already "
"knows."
msgstr ""
"သင်ယူသူတစ်ဦးက ၎င်းတို့၏ သင်တန်းတွင် ကိုယ်တိုင်စာရင်းသွင်းကြောင်း "
"သင်တန်းအဖွဲ့ထံ အသိပေးပါသည်။ ဝန်ထမ်းများ ပြုလုပ်သော စာရင်းသွင်းမှုများကို "
"ကြေညာမည်မဟုတ်ပါ — ပြုလုပ်သူက သိပြီးဖြစ်သည်။"

msgid "Certificate earned"
msgstr "လက်မှတ် ရရှိပြီး"

msgid "Sent when a learner earns a course certificate."
msgstr "သင်ယူသူတစ်ဦး သင်တန်းလက်မှတ် ရရှိသည့်အခါ ပို့ပါသည်။"

msgid ""
"Sent when a learner's certificate expires and their graded attempts are "
"reset."
msgstr ""
"သင်ယူသူ၏ လက်မှတ် သက်တမ်းကုန်ပြီး ၎င်း၏ အမှတ်ပေးကြိုးစားမှုများကို "
"ပြန်လည်သတ်မှတ်သည့်အခါ ပို့ပါသည်။"

msgid "Guest purchase — success"
msgstr "ဧည့်သည် ဝယ်ယူမှု — အောင်မြင်သည်"

msgid ""
"Receipt and access details for a guest checkout. Transactional — cannot be "
"disabled."
msgstr ""
"ဧည့်သည် ငွေပေးချေမှုအတွက် ပြေစာနှင့် ဝင်ရောက်ခွင့် အသေးစိတ်။ "
"ငွေပေးငွေယူဆိုင်ရာ — ပိတ်၍မရပါ။"

msgid "Payment failed"
msgstr "ငွေပေးချေမှု မအောင်မြင်ပါ"

msgid ""
"Warns a learner that a subscription payment failed and access will be "
"revoked. Transactional — cannot be disabled."
msgstr ""
"ကြေးပေးသုံးစွဲမှု ငွေပေးချေမှု မအောင်မြင်ကြောင်းနှင့် ဝင်ရောက်ခွင့်ကို "
"ရုပ်သိမ်းမည်ဖြစ်ကြောင်း သင်ယူသူကို သတိပေးပါသည်။ ငွေပေးငွေယူဆိုင်ရာ — "
"ပိတ်၍မရပါ။"

msgid "Purchase completed"
msgstr "ဝယ်ယူမှု ပြီးဆုံးပါပြီ"

msgid ""
"Tells the course team that a learner bought their course, or the program "
"staff that a learner bought their program."
msgstr ""
"သင်ယူသူတစ်ဦးက ၎င်းတို့၏ သင်တန်းကို ဝယ်ယူကြောင်း သင်တန်းအဖွဲ့ထံ၊ သို့မဟုတ် "
"၎င်းတို့၏ ပရိုဂရမ်ကို ဝယ်ယူကြောင်း ပရိုဂရမ်ဝန်ထမ်းများထံ အသိပေးပါသည်။"

msgid "Support ticket raised"
msgstr "အကူအညီ တီကတ် တင်သွင်းပြီး"

msgid "Notifies staff that a learner raised a support ticket."
msgstr "သင်ယူသူတစ်ဦးက အကူအညီ တီကတ်တင်သွင်းကြောင်း ဝန်ထမ်းများထံ အသိပေးပါသည်။"

msgid "Support ticket status updated"
msgstr "အကူအညီ တီကတ် အခြေအနေ အပ်ဒိတ်လုပ်ပြီး"

msgid "Notifies the learner who raised a ticket that its status changed."
msgstr ""
"တီကတ်တင်သွင်းခဲ့သော သင်ယူသူထံ ၎င်း၏ အခြေအနေ ပြောင်းလဲကြောင်း အသိပေးပါသည်။"

msgid "Support ticket assigned"
msgstr "အကူအညီ တီကတ် တာဝန်ပေးအပ်ပြီး"

msgid "Notifies a staff member that a ticket was assigned to them."
msgstr ""
"တီကတ်တစ်ခုကို ၎င်းတို့ထံ တာဝန်ပေးအပ်ကြောင်း ဝန်ထမ်းတစ်ဦးထံ အသိပေးပါသည်။"

msgid "Support ticket comment added"
msgstr "အကူအညီ တီကတ်တွင် မှတ်ချက် ထည့်သွင်းပြီး"

msgid "Notifies the other party that a comment was added to a ticket."
msgstr "တီကတ်တွင် မှတ်ချက်တစ်ခု ထည့်သွင်းကြောင်း အခြားတစ်ဖက်ထံ အသိပေးပါသည်။"

